---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import { WHATSAPP_URL } from '../config';

const features = [
  {
    icon: 'ph:chat-circle-dots',
    title: 'Atención al residente 24/7',
    desc: 'Responde dudas sobre el reglamento de convivencia, envía estados de cuenta individuales y agenda zonas comunes de forma autónoma, por WhatsApp.',
  },
  {
    icon: 'ph:clipboard-text',
    title: 'Gestión automática de PQRS',
    desc: 'Radica cada solicitud, la clasifica por nivel de urgencia y asigna los reportes de daños al técnico correspondiente, con seguimiento hasta el cierre.',
  },
  {
    icon: 'ph:trend-up',
    title: 'Cobranza preventiva y predictiva',
    desc: 'Analiza los patrones de pago para identificar qué residentes podrían entrar en mora y envía recordatorios automáticos adaptados a cada caso.',
  },
  {
    icon: 'ph:scan',
    title: 'Lectura automatizada de facturas (OCR)',
    desc: 'Procesa cuentas de cobro y facturas de proveedores con solo tomarles una foto, cruzando los datos directamente con tu sistema contable.',
  },
  {
    icon: 'ph:shield-check',
    title: 'Portería y seguridad asistida',
    desc: 'Agiliza el ingreso de visitantes con validación de datos, controla la mensajería y se conecta con tu citofonía inteligente.',
  },
];

const faqItems = [
  {
    q: '¿Cómo sabe el agente lo que dice el reglamento de mi copropiedad?',
    a: 'Se entrena con tecnología RAG directamente sobre el reglamento de propiedad horizontal de tu conjunto, así que responde con base en las normas reales de tu copropiedad, no con respuestas genéricas.',
  },
  {
    q: '¿Qué pasa si un residente reporta un daño o radica una PQRS?',
    a: 'El agente radica la solicitud, la clasifica por nivel de urgencia y la asigna al técnico correspondiente, con seguimiento hasta que se cierra el caso.',
  },
  {
    q: '¿Cómo funciona la cobranza preventiva?',
    a: 'El agente analiza los patrones de pago de cada residente para identificar quién podría entrar en mora y envía recordatorios automáticos adaptados a cada caso, antes de que la cartera se vuelva un problema.',
  },
  {
    q: '¿Puedo procesar facturas de proveedores sin digitarlas manualmente?',
    a: 'Sí. El agente lee facturas y cuentas de cobro con solo tomarles una foto (OCR) y cruza los datos directamente con tu sistema contable.',
  },
  {
    q: '¿Se integra con la portería o la citofonía del conjunto?',
    a: 'Sí, agiliza el ingreso de visitantes con validación de datos, controla la mensajería y se conecta con citofonía inteligente.',
  },
  {
    q: '¿Dónde queda el historial de las conversaciones con los residentes?',
    a: 'Cada conversación queda registrada en Livvo Chat, la misma plataforma donde trabaja tu equipo de administración.',
  },
];
---

<Base
  title="Agentes IA para Propiedad Horizontal: Livvo"
  description="Agentes de IA que leen el reglamento de tu copropiedad y responden con base en él: atención al residente 24/7, PQRS, cobranza, facturas y portería, en el WhatsApp de tu administración."
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Agentes IA para Propiedad Horizontal',
    serviceType: 'Agente de inteligencia artificial para administración de copropiedades',
    provider: { '@type': 'Organization', name: 'Livvo' },
    areaServed: 'CO',
    audience: { '@type': 'Audience', audienceType: 'Administradores de propiedad horizontal' },
    description:
      'Agentes de IA que leen el reglamento de una copropiedad y responden con base en él: atención al residente 24/7, PQRS, cobranza, facturas y portería, por WhatsApp.',
  }}
>
  <Navbar />

  <main>
    <!-- HERO centrado, estilo declaración -->
    <header class="ph-hero">
      <div class="container-site">
        <span class="ph-hero__badge">Agentes IA · Propiedad Horizontal</span>
        <h1>
          Mejores experiencias para tus residentes.
          <em class="grad-text">Construidas con Livvo.</em>
        </h1>
        <p class="ph-hero__sub">
          Agentes de IA que leen el reglamento de tu copropiedad y responden con base en él:
          atención al residente 24/7, PQRS, cobranza, facturas y portería, en el mismo WhatsApp
          de tu administración.
        </p>
        <div class="ph-hero__ctas">
          <Button href={WHATSAPP_URL} target="_blank" size="lg" id="ph-demo-cta">
            Prueba 15 días gratis →
          </Button>
        </div>
      </div>
    </header>

    <!-- QUÉ HACEN LOS AGENTES -->
    <Section
      alt
      eyebrow="Tecnología RAG"
      title="Entrenados con el reglamento de tu copropiedad"
    >
      <div class="phfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="phfeature">
            <div class="phfeature__head">
              <Icon class="phfeature__icon" name={icon} width={20} height={20} aria-hidden="true" />
              <h3 class="phfeature__title">{title}</h3>
            </div>
            <p class="phfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Pruébalo" title="Mira un agente de PH en acción">
      <div class="ph-cta fade-up">
        <p>
          La mejor forma de evaluar un agente de IA es conversar con uno. Escríbenos por WhatsApp
          y mira cómo atiende a un residente, radica una PQRS y gestiona la cobranza en una
          conversación real. Cada conversación queda registrada en
          <a href="/plataforma-de-atencion-al-cliente">Livvo Chat</a>, la misma plataforma donde
          trabaja tu equipo de administración.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="ph-cta-final">
          Prueba 15 días gratis →
        </Button>
      </div>
    </Section>

    <!-- FAQ: acordeón -->
    <Section alt eyebrow="Preguntas frecuentes" title="Lo que preguntan los administradores de PH.">
      <div class="fade-up">
        <FAQ items={faqItems} />
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .ph-hero {
    padding: 150px 0 80px;
    text-align: center;
  }
  .ph-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 199, 180, 0.4);
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.08);
  }
  .ph-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--navy);
    max-width: 820px;
    margin: 0 auto 20px;
  }
  .ph-hero h1 em {
    font-style: normal;
    display: block;
  }
  .ph-hero__sub {
    color: var(--muted);
    font-size: 18px;
    line-height: var(--lh-body);
    max-width: 680px;
    margin: 0 auto 32px;
  }
  .ph-hero__ctas {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- Tarjetas de funciones (mismo patrón de las páginas de producto) ---- */
  .phfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .phfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: border-color var(--transition);
  }
  .phfeature:hover {
    border-color: rgba(0, 199, 180, 0.45);
  }
  /* icono plano en línea con el título, sin chip ni glow */
  .phfeature__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-2);
  }
  .phfeature__icon {
    flex-shrink: 0;
    color: var(--teal-deep);
  }
  .phfeature__title {
    font-size: var(--text-h3);
    margin: 0;
  }
  .phfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  .ph-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .ph-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }
  .ph-cta a {
    color: var(--teal-deep);
    font-weight: 600;
    text-decoration: none;
  }
  .ph-cta a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .phfeatures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ph-hero { padding: 130px 0 60px; }
    .phfeatures { grid-template-columns: 1fr; }
  }
</style>
