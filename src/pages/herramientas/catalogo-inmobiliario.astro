---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import Section from '../../components/Section.astro';
import fotoPropiedad1 from '../../assets/catalogo-inmobiliario/propiedad-1.jpg';
import fotoPropiedad2 from '../../assets/catalogo-inmobiliario/propiedad-2.jpg';
import fotoPropiedad3 from '../../assets/catalogo-inmobiliario/propiedad-3.jpg';

// El catálogo es un producto aparte (portal_inmobiliario_fast), con su propia
// base de datos: cuenta por número de celular, compartida entre WhatsApp y
// desktop. Esta página solo enlaza hacia allá — el login vive en ese dominio.
const APP_URL = 'https://portalinmobiliariofast.vercel.app/login';

const WHATSAPP_BOT_NUMBER = '12052843965';
const WHATSAPP_BOT_MESSAGE =
  'Hola quiero crear mi ficha inmobiliaria web \nVENDEMOS APARTAMENTO EN SANTA ANA OCCIDENTAL';
const WHATSAPP_BOT_URL = `https://wa.me/${WHATSAPP_BOT_NUMBER}?text=${encodeURIComponent(WHATSAPP_BOT_MESSAGE)}`;

// Solo se listan campos y formatos que el producto ya tiene hoy. No incluir
// PDF, video, mapa, estadísticas de visitas ni estrato/piso/año de
// construcción: el producto no los tiene todavía.
const incluye = [
  { icon: 'ph:camera', label: 'Fotos de la propiedad' },
  { icon: 'ph:note-pencil', label: 'Título y descripción' },
  { icon: 'ph:tag', label: 'Precio de venta o arriendo' },
  { icon: 'ph:ruler', label: 'Área construida' },
  { icon: 'ph:bed', label: 'Habitaciones, baños y parqueaderos' },
  { icon: 'ph:sparkle', label: 'Características especiales: piscina, gimnasio, cocina integral…' },
  { icon: 'ph:map-pin', label: 'Ciudad y barrio' },
  { icon: 'ph:whatsapp-logo', label: 'Nombre y WhatsApp del agente' },
  { icon: 'ph:link-simple', label: 'Link propio para compartir' },
];

const fotosPropiedad = [fotoPropiedad1, fotoPropiedad2, fotoPropiedad3];

const pasos = [
  {
    n: '01',
    title: 'Crea tu cuenta gratis',
    desc: 'Escribe tu número de celular. Sin contraseñas ni tarjeta de crédito.',
  },
  {
    n: '02',
    title: 'Carga tu propiedad',
    desc: 'Sube las fotos y completa precio, ubicación, habitaciones y características — por WhatsApp o desde tu computador.',
  },
  {
    n: '03',
    title: 'Comparte y capta clientes',
    desc: 'Tu propiedad ya tiene página web propia y aparece en tu catálogo. Compártela por WhatsApp o en tus redes.',
  },
];

const formatos = [
  {
    icon: 'ph:globe',
    title: 'Página web de la propiedad',
    desc: 'Cada ficha tiene su propia URL, con galería de fotos y un botón directo a tu WhatsApp. Se ve bien en el celular y en el computador.',
    ideal: 'Redes sociales y mensajería',
  },
  {
    icon: 'ph:buildings',
    title: 'Catálogo del agente',
    desc: 'Todas tus propiedades publicadas en una sola página, con tu nombre y tu WhatsApp. Tu vitrina digital.',
    ideal: 'Tarjeta de presentación digital',
  },
];

const beneficios = [
  {
    icon: 'ph:arrows-clockwise',
    title: 'Generado automáticamente',
    desc: 'No tienes que diseñar nada. Cargas los datos y la ficha queda lista al instante. Cambias el precio y se actualiza sola.',
  },
  {
    icon: 'ph:whatsapp-logo',
    title: 'Optimizado para WhatsApp',
    desc: 'El link es liviano y se abre directo en el celular de tu cliente, sin apps adicionales.',
  },
  {
    icon: 'ph:device-mobile',
    title: 'Una cuenta, dos canales',
    desc: 'Crea y edita tus propiedades desde WhatsApp o desde tu computador — es la misma cuenta y el mismo catálogo.',
  },
  {
    icon: 'ph:credit-card',
    title: 'Gratis, sin tarjeta de crédito',
    desc: 'Empieza a publicar en minutos, sin compromisos.',
  },
];
---

<Base
  title="Catálogo Inmobiliario — Livvo"
  description="Crea tu catálogo inmobiliario gratis: carga tus propiedades por WhatsApp o desde tu computador y obtén al instante una página web por propiedad y tu catálogo de agente, listos para compartir."
  noindex
>
  <Navbar />

  <main>
    <!-- HERO -->
    <header class="ci-hero">
      <div class="container-site ci-hero__inner">
        <div class="ci-hero__copy">
          <span class="eyebrow">Herramienta gratuita de Livvo</span>
          <h1>Crea tu <span class="grad-text">catálogo inmobiliario</span></h1>
          <p class="ci-hero__sub">
            Carga tus propiedades por WhatsApp o desde tu computador, sin tarjeta de crédito.
            Cada propiedad obtiene su propia página web y todas juntas forman tu catálogo,
            listo para compartir con tus clientes.
          </p>
          <div class="ci-hero__ctas">
            <Button href={WHATSAPP_BOT_URL} target="_blank" size="lg" id="ci-hero-cta-whatsapp">
              <Icon name="ph:whatsapp-logo" /> Crear por WhatsApp
            </Button>
            <Button href={APP_URL} target="_blank" size="lg" variant="outline" id="ci-hero-cta-web">
              <Icon name="ph:desktop" /> Crear desde el computador
            </Button>
          </div>
          <p class="ci-hero__note">Con tu número de WhatsApp · Sin tarjeta de crédito</p>
        </div>

        <div class="ci-hero__visual">
          <div class="ci-card fade-up">
            <div class="ci-card__photo">
              <!-- Fotos reales de ejemplo, con crossfade puro en CSS
                   — ver @keyframes ci-slide-fade más abajo. -->
              {fotosPropiedad.map((foto, i) => (
                <div class="ci-card__slide" style={`animation-delay: ${i * 4}s;`} aria-hidden="true">
                  <Image
                    src={foto}
                    alt="Foto de ejemplo de una propiedad publicada en el catálogo"
                    width={760}
                    height={380}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
              <span class="ci-card__badge">En venta</span>
              <span class="ci-card__photos"><Icon name="ph:camera" /> 8 fotos</span>
            </div>
            <div class="ci-card__body">
              <p class="ci-card__meta">Apartamento · El Poblado, Medellín</p>
              <p class="ci-card__price">$450.000.000</p>
              <div class="ci-card__specs">
                <span>3 hab.</span>
                <span>2 baños</span>
                <span>85 m²</span>
              </div>
              <p class="ci-card__desc">
                Apartamento con acabados de primera, cocina integral y balcón con vista a la
                ciudad…
              </p>
              <div class="ci-card__agent">
                <span class="ci-card__avatar">CA</span>
                <div class="ci-card__agent-info">
                  <p class="ci-card__agent-name">Carlos Agente</p>
                  <p class="ci-card__agent-phone">+57 310 456 7890</p>
                </div>
                <Icon name="ph:whatsapp-logo" class="ci-card__wa" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- QUÉ INCLUYE -->
    <Section
      alt
      eyebrow="Todo en un solo lugar"
      title="Qué incluye cada ficha de tu catálogo"
    >
      <ul class="ci-incluye fade-up">
        {incluye.map(({ icon, label }) => (
          <li class="ci-incluye__item">
            <Icon name={icon} />
            <span>{label}</span>
          </li>
        ))}
      </ul>
    </Section>

    <!-- CÓMO FUNCIONA -->
    <Section eyebrow="Cómo funciona" title="Tres pasos y tu catálogo está listo">
      <ol class="ci-timeline fade-up">
        {pasos.map(({ n, title, desc }) => (
          <li class="ci-timeline__step">
            <span class="ci-timeline__marker" aria-hidden="true"></span>
            <span class="ci-timeline__num">{n}</span>
            <h3 class="ci-timeline__title">{title}</h3>
            <p class="ci-timeline__desc">{desc}</p>
          </li>
        ))}
      </ol>
    </Section>

    <!-- 2 FORMATOS -->
    <Section
      alt
      eyebrow="Un solo cargue"
      title="Tu propiedad en 2 formatos"
      subtitle="Cada propiedad que publicas genera automáticamente su página web y aparece en tu catálogo de agente."
    >
      <div class="ci-formatos fade-up">
        {formatos.map(({ icon, title, desc, ideal }) => (
          <div class="ci-formato">
            <div class="ci-formato__icon"><Icon name={icon} /></div>
            <h3>{title}</h3>
            <p class="ci-formato__desc">{desc}</p>
            <p class="ci-formato__ideal"><strong>Ideal para:</strong> {ideal}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- BENEFICIOS -->
    <Section eyebrow="Por qué Livvo" title="Hecho para que no pierdas tiempo">
      <div class="ci-beneficios fade-up">
        {beneficios.map(({ icon, title, desc }) => (
          <div class="ci-beneficio">
            <div class="ci-beneficio__icon"><Icon name={icon} /></div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section alt eyebrow="Pruébalo" title="Crea tu primera ficha ahora mismo">
      <div class="ci-cta fade-up">
        <p>
          Carga una propiedad real y en minutos tienes su página web y tu catálogo listos para
          compartir.
        </p>
        <div class="ci-cta__ctas">
          <Button href={WHATSAPP_BOT_URL} target="_blank" size="lg" id="ci-cta-final-whatsapp">
            <Icon name="ph:whatsapp-logo" /> Crear por WhatsApp
          </Button>
          <Button href={APP_URL} target="_blank" size="lg" variant="outline" id="ci-cta-final-web">
            <Icon name="ph:desktop" /> Crear desde el computador
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <!-- WIDGET FLOTANTE: crear catálogo por WhatsApp -->
  <div class="wa-widget" id="wa-widget">
    <div class="wa-widget__panel" id="wa-panel" hidden>
      <button type="button" class="wa-widget__close" id="wa-close" aria-label="Cerrar">✕</button>
      <p class="wa-widget__title">💬 Crea tu catálogo por WhatsApp</p>
      <p class="wa-widget__desc">
        Envíanos el anuncio de tu propiedad (texto + fotos) y te generamos la ficha
        automáticamente.
      </p>
      <a
        href={WHATSAPP_BOT_URL}
        target="_blank"
        rel="noopener"
        class="wa-widget__cta"
        id="ci-whatsapp-cta"
      >
        Abrir WhatsApp →
      </a>
    </div>
    <button
      type="button"
      class="wa-widget__trigger"
      id="wa-trigger"
      aria-label="Crear catálogo por WhatsApp"
      aria-expanded="false"
    >
      <Icon name="ph:whatsapp-logo" width={30} height={30} />
    </button>
  </div>

  <Footer />
</Base>

<script>
  const widget = document.getElementById('wa-widget');
  const trigger = document.getElementById('wa-trigger');
  const panel = document.getElementById('wa-panel');
  const closeBtn = document.getElementById('wa-close');

  function setOpen(open: boolean) {
    if (!panel || !trigger) return;
    panel.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
  }

  trigger?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('click', (e) => {
    if (!panel || panel.hidden) return;
    if (widget && !widget.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  /* ---- Hero ---- */
  .ci-hero {
    padding: 96px 0 40px;
    overflow: hidden;
  }
  .ci-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-10, 40px);
  }
  .ci-hero h1 {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 20px 0 16px;
  }
  .ci-hero__sub {
    color: var(--muted);
    font-size: 18px;
    line-height: var(--lh-body);
    max-width: 480px;
    margin: 0 0 28px;
  }
  .ci-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ci-hero__note {
    margin: 14px 0 0;
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* ---- Tarjeta mockup de propiedad ---- */
  .ci-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    max-width: 380px;
    margin-inline: auto;
  }
  .ci-card__photo {
    position: relative;
    height: 180px;
    overflow: hidden;
    background: #dee9ff;
  }
  .ci-card__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: ci-slide-fade 12s infinite;
  }
  .ci-card__slide img { width: 100%; height: 100%; display: block; object-fit: cover; }
  @keyframes ci-slide-fade {
    0%, 4% { opacity: 0; }
    8%, 28% { opacity: 1; }
    33%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ci-card__slide { animation: none; opacity: 0; }
    .ci-card__slide:first-child { opacity: 1; }
  }
  .ci-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--navy);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
  }
  .ci-card__photos {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(13, 20, 36, 0.55);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
  }
  .ci-card__photos [data-icon] { width: 12px; height: 12px; }
  .ci-card__body { padding: 18px 20px 20px; }
  .ci-card__meta { font-size: 13px; color: var(--muted); margin: 0 0 4px; }
  .ci-card__price {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 10px;
  }
  .ci-card__specs {
    display: flex;
    gap: 14px;
    font-size: 13px;
    color: var(--text);
    font-weight: 600;
    margin: 0 0 12px;
  }
  .ci-card__desc {
    font-size: 13px;
    line-height: var(--lh-body);
    color: var(--muted);
    margin: 0 0 16px;
  }
  .ci-card__agent {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .ci-card__avatar {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--grad-flow);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-card__agent-info { flex: 1; min-width: 0; }
  .ci-card__agent-name { font-size: 13px; font-weight: 700; color: var(--navy); margin: 0; }
  .ci-card__agent-phone { font-size: 12px; color: var(--muted); margin: 0; }
  .ci-card__wa { color: var(--green); flex-shrink: 0; width: 22px; height: 22px; }

  /* ---- Qué incluye ---- */
  .ci-incluye {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4, 16px) var(--space-8, 32px);
    max-width: 820px;
    margin: 0 auto;
    padding: 0;
  }
  .ci-incluye__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    color: var(--text);
  }
  .ci-incluye__item [data-icon] {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--teal-deep);
    margin-top: 1px;
  }

  /* ---- Timeline (mismo patrón que Agente de Requerimientos) ---- */
  .ci-timeline {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8, 32px);
    margin: 0;
    padding: 0;
  }
  .ci-timeline__step { position: relative; padding-top: var(--space-8, 32px); }
  .ci-timeline__step::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: calc(-1 * var(--space-8, 32px));
    height: 1px;
    background: var(--border);
  }
  .ci-timeline__step:last-child::before { right: 0; }
  .ci-timeline__marker {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--teal-deep);
  }
  .ci-timeline__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: var(--ls-label);
    color: var(--teal-deep);
    margin-bottom: var(--space-2, 8px);
  }
  .ci-timeline__title { font-size: var(--text-h3); margin: 0 0 var(--space-2, 8px); }
  .ci-timeline__desc { color: var(--muted); font-size: var(--text-small); line-height: var(--lh-body); margin: 0; }

  /* ---- 2 formatos ---- */
  .ci-formatos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6, 24px);
    max-width: 820px;
    margin: 0 auto;
  }
  .ci-formato {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-8, 32px);
  }
  .ci-formato__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(0, 199, 180, 0.1);
    color: var(--teal-deep);
    margin-bottom: var(--space-4, 16px);
  }
  .ci-formato__icon [data-icon] { width: 22px; height: 22px; }
  .ci-formato h3 { margin: 0 0 var(--space-2, 8px); }
  .ci-formato__desc { color: var(--muted); font-size: var(--text-small); line-height: var(--lh-body); margin: 0 0 var(--space-4, 16px); }
  .ci-formato__ideal { font-size: 13px; color: var(--text); margin: 0; }
  .ci-formato__ideal strong { color: var(--navy); }

  /* ---- Beneficios ---- */
  .ci-beneficios {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6, 24px);
  }
  .ci-beneficio__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(59, 126, 255, 0.1);
    color: var(--blue);
    margin-bottom: var(--space-4, 16px);
  }
  .ci-beneficio__icon [data-icon] { width: 20px; height: 20px; }
  .ci-beneficio h3 { font-size: var(--text-h3); margin: 0 0 var(--space-2, 8px); }
  .ci-beneficio p { color: var(--muted); font-size: var(--text-small); line-height: var(--lh-body); margin: 0; }

  /* ---- CTA final ---- */
  .ci-cta { max-width: 620px; margin-inline: auto; text-align: center; }
  .ci-cta p { color: var(--muted); font-size: 16px; line-height: var(--lh-body); margin: 0 0 24px; }
  .ci-cta__ctas {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- Widget flotante de WhatsApp ---- */
  .wa-widget {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .wa-widget__trigger {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 50%;
    border: none;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: transform var(--transition);
  }
  .wa-widget__trigger:hover { transform: scale(1.06); }
  .wa-widget__panel {
    width: min(300px, calc(100vw - 40px));
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    padding: 20px;
    position: relative;
  }
  .wa-widget__close {
    position: absolute;
    top: 10px;
    right: 10px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
  }
  .wa-widget__title { font-weight: 700; color: var(--navy); margin: 0 0 8px; padding-right: 20px; }
  .wa-widget__desc { font-size: 13.5px; color: var(--muted); line-height: var(--lh-body); margin: 0 0 14px; }
  .wa-widget__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: #25d366;
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 16px;
    border-radius: var(--radius-btn);
    text-decoration: none;
    transition: filter var(--transition);
  }
  .wa-widget__cta:hover { filter: brightness(0.95); color: #fff; }

  @media (max-width: 1024px) {
    .ci-hero__inner { grid-template-columns: 1fr; text-align: center; gap: var(--space-8, 32px); }
    .ci-hero__sub { margin-inline: auto; }
    .ci-hero__ctas { justify-content: center; }
    .ci-beneficios { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .ci-timeline { grid-template-columns: 1fr; gap: 0; }
    .ci-timeline__step { padding: 0 0 var(--space-8, 32px) var(--space-8, 32px); }
    .ci-timeline__step::before { top: 0; left: 7px; right: auto; bottom: 0; width: 1px; height: auto; }
    .ci-timeline__step:last-child::before { display: none; }
    .ci-formatos { grid-template-columns: 1fr; }
