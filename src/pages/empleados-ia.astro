---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';

const features = [
  {
    icon: 'chat',
    title: 'Atención al cliente 24/7',
    desc: 'Luisa responde en segundos, con el tono de tu inmobiliaria, a inquilinos y propietarios en cualquier momento — también de noche y en fines de semana.',
  },
  {
    icon: 'filter',
    title: 'Calificación automática de leads',
    desc: 'Detecta quién realmente desea alquilar o comprar, captura presupuesto, zona y liquidez, y te entrega solo los leads listos para avanzar.',
  },
  {
    icon: 'home',
    title: 'Recomendación de inmuebles',
    desc: 'Cada lead recibe propiedades de tu portafolio que encajan con lo que busca, directo en el chat.',
  },
  {
    icon: 'calendar',
    title: 'Agendamiento de visitas',
    desc: 'Coordina la cita en la misma conversación, sin idas y vueltas de mensajes con tu equipo.',
  },
  {
    icon: 'target',
    title: 'Supervisada por tu equipo',
    desc: 'Tú decides el nivel de autonomía: responde sola o prepara borradores que tus asesores revisan y aprueban antes de enviar.',
  },
  {
    icon: 'spark',
    title: 'Entrenada para tu inmobiliaria',
    desc: 'Antes de salir a producción la configuramos contigo: tu tono, tu portafolio y tus reglas de negocio.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  filter: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
  home: '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 8.5V21h14V8.5"/><path d="M9 21v-6h6v6"/>',
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  spark:
    '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3"/>',
};
---

<Base
  title="Empleados IA — Livvo"
  description="Luisa y tus empleados digitales atienden WhatsApp 24/7: responden en segundos, califican cada lead y agendan visitas con el tono de tu inmobiliaria."
>
  <Navbar />

  <main>
    <!-- HERO del producto -->
    <header class="product-hero product-hero--luisa">
      <div class="container-site product-hero__inner">
        <span class="product-hero__badge">Producto · Empleados IA</span>
        <h1>Empleados IA que <em class="grad-text">venden por ti.</em></h1>
        <p class="product-hero__sub">
          Luisa y tus empleados digitales atienden el WhatsApp de tu inmobiliaria 24/7: responden
          en segundos, califican cada lead, recomiendan inmuebles de tu portafolio y agendan
          visitas — con tu tono y bajo tus reglas.
        </p>
        <div class="product-hero__ctas">
          <Button href={WHATSAPP_URL} target="_blank" size="lg" id="empleados-demo-cta">
            Conversar con Livvo →
          </Button>
          <Button href="/plataforma-comercial" variant="ghost" size="lg">
            Ver la Plataforma Comercial
          </Button>
        </div>
      </div>
    </header>

    <!-- DEMO — conversación real de WhatsApp con Luisa -->
    <section class="demo" aria-label="Conversación de WhatsApp con Luisa">
      <div class="demo__bg" aria-hidden="true">
        <svg class="demo__circles" viewBox="0 0 200 200" fill="none" stroke="currentColor">
          <circle cx="100" cy="100" r="90" stroke-width="0.35" stroke-dasharray="2 3" />
          <circle cx="100" cy="100" r="68" stroke-width="0.35" />
          <circle cx="100" cy="100" r="46" stroke-width="0.4" stroke-dasharray="1 2" />
          <circle cx="100" cy="100" r="24" stroke-width="0.5" stroke="#6C63FF" opacity="0.35" />
        </svg>
      </div>
      <div class="container-site demo__inner">
        <iframe
          src="/livvo-whatsapp.html"
          width="424"
          height="740"
          loading="lazy"
          scrolling="no"
          title="Conversación de WhatsApp con Luisa, la IA de Livvo"
          class="demo__frame"></iframe>
      </div>
    </section>

    <!-- QUÉ HACEN -->
    <Section
      eyebrow="Qué hacen"
      title="Un empleado que nunca deja un lead en visto"
      subtitle="Todo lo que tus Empleados IA resuelven antes de que un asesor humano tenga que intervenir."
      alt
    >
      <div class="pfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="pfeature">
            <span class="pfeature__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={featureIcons[icon]}
              />
            </span>
            <h3 class="pfeature__title">{title}</h3>
            <p class="pfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Pruébalo" title="Habla con Luisa ahora mismo">
      <div class="product-cta fade-up">
        <p>
          La mejor forma de evaluar un Empleado IA es conversar con uno. Escríbele a Luisa por
          WhatsApp y mira cómo atiende, califica y recomienda en una conversación real.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="empleados-cta-final">
          Conversar con Livvo →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .product-hero {
    padding: 140px 0 80px;
  }
  .product-hero__inner {
    max-width: 800px;
    text-align: center;
    margin-inline: auto;
  }
  .product-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(108, 99, 255, 0.4);
    color: var(--violet);
    background: rgba(108, 99, 255, 0.08);
  }
  .product-hero h1 {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 0 0 16px;
  }
  .product-hero h1 em {
    font-style: normal;
  }
  .product-hero__sub {
    color: var(--muted);
    font-size: 17px;
    line-height: var(--lh-body);
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .product-hero__ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ---- Demo: teléfono con anillos concéntricos (patrón del DS) ---- */
  .demo {
    position: relative;
    overflow: hidden;
    padding: 8px 0 96px;
    background: var(--white);
  }
  .demo__inner {
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .demo__frame {
    border: 0;
    max-width: 100%;
    display: block;
  }
  .demo__bg {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(1100px, 170vw);
    height: min(1100px, 170vw);
    transform: translate(-50%, -50%);
    color: var(--border);
    pointer-events: none;
    z-index: 0;
  }
  /* máscara radial: los anillos se desvanecen hacia los bordes */
  .demo__bg::after {
    content: '';
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at center, transparent 30%, var(--white) 78%);
  }
  .demo__circles {
    width: 100%;
    height: 100%;
    display: block;
    animation: rings-spin 140s linear infinite;
  }
  @keyframes rings-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo__circles { animation: none; }
  }

  .pfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .pfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: box-shadow var(--transition), border-color var(--transition),
      background-color var(--transition), transform var(--transition);
  }
  .pfeature:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    background: rgba(108, 99, 255, 0.07);
    border-color: rgba(108, 99, 255, 0.45);
  }
  .pfeature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    margin-bottom: var(--space-4);
    background: rgba(108, 99, 255, 0.1);
    color: var(--violet);
    transition: background-color var(--transition), color var(--transition);
  }
  .pfeature:hover .pfeature__icon {
    background: var(--grad-violet);
    color: #fff;
  }
  .pfeature__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .pfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  .product-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .product-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .pfeatures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .product-hero { padding: 120px 0 60px; }
    .product-hero h1 { font-size: 34px; }
    .pfeatures { grid-template-columns: 1fr; }
  }
</style>
