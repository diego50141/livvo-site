---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  alt?: boolean; // fondo alterno (--gray-bg)
  dark?: boolean; // sección en navy oscuro (ritmo dark/white tipo Nexiu)
}

const { id, eyebrow, title, subtitle, alt = false, dark = false } = Astro.props;
---

<section
  {id}
  class:list={['section', { 'section--alt': alt, 'section--dark': dark, 'theme-dark-scope': dark }]}
>
  <div class="container-site">
    {
      (eyebrow || title) && (
        <div class="section__head fade-up">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2>{title}</h2>}
          {subtitle && <p class="section__subtitle">{subtitle}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section { padding: 128px 0; background: var(--white); transition: background-color var(--transition); }
  .section--alt { background: var(--gray-bg); }
  /* fondo oscuro del DS con los brillos teal/azul de las ilustraciones */
  .section--dark {
    background:
      radial-gradient(circle at 15% 25%, rgba(0, 199, 180, 0.09) 0%, transparent 45%),
      radial-gradient(circle at 85% 75%, rgba(59, 126, 255, 0.07) 0%, transparent 45%),
      linear-gradient(180deg, #070b14 0%, #0a0e1a 100%);
  }
  .section__head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 64px;
  }
  /* mismo tamaño de título en TODAS las secciones */
  .section__head h2 {
    margin-top: var(--space-4);
    font-size: clamp(32px, 4vw, 44px);
    letter-spacing: -1px;
  }
  /* mismo tamaño de subtítulo en todas las secciones (--text-h2) */
  .section__subtitle {
    font-size: var(--text-h2);
    line-height: var(--lh-body);
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  @media (max-width: 768px) {
    .section { padding: 80px 0; }
    .section__head { margin-bottom: 48px; }
  }
</style>
