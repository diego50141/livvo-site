---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';
import fotoLuisa from '../assets/equipo/luisa.png';
import fotoLucia from '../assets/equipo/lucia.png';
import fotoLaura from '../assets/equipo/laura.png';
import fotoLina from '../assets/equipo/lina.jpg';

const features = [
  {
    icon: 'chat',
    title: 'Atención al cliente 24/7',
    desc: 'Luisa responde en segundos, con el tono de tu inmobiliaria, a inquilinos y propietarios en cualquier momento — también de noche y en fines de semana.',
  },
  {
    icon: 'filter',
    title: 'Calificación automática de leads',
    desc: 'Detecta quién realmente desea alquilar o comprar, captura presupuesto, zona y liquidez, y te entrega solo los leads listos para avanzar.',
  },
  {
    icon: 'home',
    title: 'Recomendación de inmuebles',
    desc: 'Cada lead recibe propiedades de tu portafolio que encajan con lo que busca, directo en el chat.',
  },
  {
    icon: 'calendar',
    title: 'Agendamiento de visitas',
    desc: 'Coordina la cita en la misma conversación, sin idas y vueltas de mensajes con tu equipo.',
  },
  {
    icon: 'refresh',
    title: 'Seguimientos automatizados',
    desc: 'Si un lead deja de responder, Luisa retoma la conversación por ti: recordatorios y seguimientos en el momento justo, hasta agendar la visita o cerrar el ciclo.',
  },
  {
    icon: 'send',
    title: 'Outreach a escala',
    desc: 'Reactiva tu base de datos con campañas salientes por WhatsApp: la misma conversación personalizada, para cien o para diez mil contactos.',
  },
];

const team = [
  {
    foto: fotoLucia,
    nombre: 'Lucía',
    rol: 'Mantenimiento IA',
    desc: 'Recibe las solicitudes de mantenimiento de tus inquilinos, coordina proveedores y hace seguimiento automático hasta cerrar cada caso.',
  },
  {
    foto: fotoLaura,
    nombre: 'Laura',
    rol: 'Administrativa IA',
    desc: 'Atiende a inquilinos y propietarios 24/7: resuelve consultas de pagos, certificados y trámites sin intervención humana, con una respuesta personalizada para cada caso.',
  },
  {
    foto: fotoLina,
    nombre: 'Lina',
    rol: 'Jurídica IA',
    desc: 'Gestiona la cobranza y los recordatorios de pago por WhatsApp, con el tono firme y cordial que protege la relación con tu cliente.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  filter: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
  home: '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 8.5V21h14V8.5"/><path d="M9 21v-6h6v6"/>',
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/>',
  send: '<path d="m22 2-7 20-4-9-9-4 20-7z"/><path d="M22 2 11 13"/>',
};
---

<Base
  title="Empleados IA — Livvo"
  description="Luisa y su equipo de Empleados IA atienden el WhatsApp de tu inmobiliaria 24/7: ventas, mantenimiento, administración y cobranza, con tu tono y bajo tus reglas."
>
  <Navbar />

  <main>
    <!-- HERO del producto: texto a la izquierda, demo de WhatsApp a la derecha -->
    <header class="product-hero product-hero--luisa">
      <div class="container-site product-hero__inner">
        <div class="product-hero__copy">
          <span class="product-hero__badge">Producto · Empleados IA</span>
          <h1>Empleados IA que <em class="grad-text">venden por ti.</em></h1>
          <p class="product-hero__sub">
            Luisa responde en segundos, califica cada lead, recomienda inmuebles de tu portafolio y
            agenda visitas — mientras Lucía, Laura y Lina se encargan del mantenimiento, la
            administración y la cobranza. Con tu tono y bajo tus reglas, 24/7.
          </p>
          <div class="product-hero__ctas">
            <Button href={WHATSAPP_URL} target="_blank" size="lg" id="empleados-demo-cta">
              Conversar con Livvo →
            </Button>
          </div>
        </div>

        <div class="product-hero__demo" aria-label="Conversación de WhatsApp con Luisa">
          <div class="demo__bg" aria-hidden="true">
            <svg class="demo__circles" viewBox="0 0 200 200" fill="none" stroke="currentColor">
              <circle cx="100" cy="100" r="90" stroke-width="0.35" stroke-dasharray="2 3" />
              <circle cx="100" cy="100" r="68" stroke-width="0.35" />
              <circle cx="100" cy="100" r="46" stroke-width="0.4" stroke-dasharray="1 2" />
              <circle cx="100" cy="100" r="24" stroke-width="0.5" stroke="#6C63FF" opacity="0.35" />
            </svg>
          </div>
          <iframe
            src="/livvo-whatsapp.html"
            width="424"
            height="740"
            loading="lazy"
            scrolling="no"
            title="Conversación de WhatsApp con Luisa, la IA de Livvo"
            class="demo__frame"></iframe>
        </div>
      </div>
    </header>

    <!-- AGENTE ESTRELLA: Luisa -->
    <Section alt>
      <div class="star-head fade-up">
        <span class="eyebrow">Nuestra agente estrella</span>
        <h2>Luisa, tu Agente Comercial IA</h2>
        <Image
          src={fotoLuisa}
          alt="Luisa, Agente Comercial IA de Livvo"
          width={280}
          densities={[1, 2]}
          class="star-head__foto"
        />
        <p class="star-head__subtitle">
          La primera línea de tu equipo comercial: atiende, califica, recomienda y agenda — sin
          dejar un lead en visto.
        </p>
      </div>
      <div class="pfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="pfeature">
            <span class="pfeature__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={featureIcons[icon]}
              />
            </span>
            <h3 class="pfeature__title">{title}</h3>
            <p class="pfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- EL RESTO DEL EQUIPO -->
    <Section
      eyebrow="El equipo completo"
      title="Luisa no trabaja sola"
      subtitle="Empleados IA especializados para cada área de tu inmobiliaria, en el mismo WhatsApp."
    >
      <div class="team fade-up">
        {team.map(({ foto, nombre, rol, desc }) => (
          <article class="tcard">
            <Image
              src={foto}
              alt={`${nombre}, ${rol} de Livvo`}
              width={240}
              densities={[1, 2]}
              class="tcard__foto"
            />
            <h3 class="tcard__nombre">{nombre}</h3>
            <span class="tcard__rol">{rol}</span>
            <p class="tcard__desc">{desc}</p>
          </article>
        ))}
      </div>
      <p class="team__note fade-up">
        Cada Empleado IA se configura contigo antes de salir a producción — tu tono, tu portafolio
        y tus reglas de negocio — y trabaja con el nivel de autonomía que tú decidas: responde solo
        o prepara borradores que tu equipo revisa y aprueba.
      </p>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Pruébalo" title="Habla con Luisa ahora mismo">
      <div class="product-cta fade-up">
        <p>
          La mejor forma de evaluar un Empleado IA es conversar con uno. Escríbele a Luisa por
          WhatsApp y mira cómo atiende, califica y recomienda en una conversación real.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="empleados-cta-final">
          Conversar con Livvo →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .product-hero {
    padding: 130px 0 40px;
    overflow: hidden;
  }
  .product-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-10);
  }
  .product-hero__copy {
    text-align: left;
  }
  .product-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(108, 99, 255, 0.4);
    color: var(--violet);
    background: rgba(108, 99, 255, 0.08);
  }
  .product-hero h1 {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 0 0 16px;
  }
  .product-hero h1 em {
    font-style: normal;
  }
  .product-hero__sub {
    color: var(--muted);
    font-size: 17px;
    line-height: var(--lh-body);
    max-width: 560px;
    margin: 0 0 32px;
  }
  .product-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- Demo en el hero: teléfono con anillos concéntricos (patrón del DS) ---- */
  .product-hero__demo {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .demo__frame {
    border: 0;
    max-width: 100%;
    display: block;
    position: relative;
    z-index: 1;
  }
  .demo__bg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(680px, 100vw);
    height: min(680px, 100vw);
    transform: translate(-50%, -50%);
    color: var(--border);
    pointer-events: none;
    z-index: 0;
  }
  /* máscara radial: los anillos se desvanecen hacia los bordes */
  .demo__bg::after {
    content: '';
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at center, transparent 30%, var(--white) 78%);
  }
  .demo__circles {
    width: 100%;
    height: 100%;
    display: block;
    animation: rings-spin 140s linear infinite;
  }
  @keyframes rings-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo__circles { animation: none; }
  }

  /* ---- Cabecera de la agente estrella (replica .section__head + foto) ---- */
  .star-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--space-12);
  }
  .star-head :global(.star-head__foto) {
    display: block;
    width: 220px;
    height: 220px;
    object-fit: cover;
    margin: var(--space-6) auto 0;
    border-radius: 50%;
    border: 4px solid rgba(108, 99, 255, 0.45);
    box-shadow: 0 10px 40px rgba(108, 99, 255, 0.22);
  }
  @media (max-width: 640px) {
    .star-head :global(.star-head__foto) {
      width: 170px;
      height: 170px;
    }
  }
  .star-head h2 {
    margin-top: var(--space-4);
    font-size: clamp(32px, 4vw, 44px);
    letter-spacing: -1px;
  }
  .star-head__subtitle {
    font-size: var(--text-h2);
    line-height: var(--lh-body);
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }

  .pfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .pfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: box-shadow var(--transition), border-color var(--transition),
      background-color var(--transition), transform var(--transition);
  }
  .pfeature:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    background: rgba(108, 99, 255, 0.07);
    border-color: rgba(108, 99, 255, 0.45);
  }
  .pfeature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    margin-bottom: var(--space-4);
    background: rgba(108, 99, 255, 0.1);
    color: var(--violet);
    transition: background-color var(--transition), color var(--transition);
  }
  .pfeature:hover .pfeature__icon {
    background: var(--grad-violet);
    color: #fff;
  }
  .pfeature__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .pfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  /* ---- Equipo de Empleados IA ---- */
  .team {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .tcard {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    text-align: center;
    transition: box-shadow var(--transition), border-color var(--transition),
      transform var(--transition);
  }
  .tcard:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    border-color: rgba(0, 199, 180, 0.45);
  }
  .tcard :global(.tcard__foto) {
    display: block;
    width: 120px;
    height: 120px;
    object-fit: cover;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    border: 3px solid rgba(0, 199, 180, 0.35);
  }
  .tcard__nombre {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-1);
  }
  .tcard__rol {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.1);
    border-radius: 20px;
    padding: 3px 12px;
    margin-bottom: var(--space-3);
  }
  .tcard__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }
  .team__note {
    max-width: 680px;
    margin: var(--space-8) auto 0;
    text-align: center;
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
  }

  .product-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .product-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .product-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .product-hero__copy {
      text-align: center;
      max-width: 640px;
      margin-inline: auto;
    }
    .product-hero__sub { margin-inline: auto; }
    .product-hero__ctas { justify-content: center; }
    .pfeatures { grid-template-columns: repeat(2, 1fr); }
    .team { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .product-hero { padding: 120px 0 40px; }
    .product-hero h1 { font-size: 34px; }
    .pfeatures { grid-template-columns: 1fr; }
    .team { grid-template-columns: 1fr; }
  }
</style>
