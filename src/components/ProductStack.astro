---
// Visual del hero: las tres pantallas reales del producto en capas.
// Solo CSS — sin JS ni librerías — para no sumar peso al LCP.
// El orden del DOM va de atrás hacia adelante.

interface Props {
  // En un hero las tres capas deben cargar de inmediato: en diferido se ven
  // tres tarjetas vacías durante el primer instante. Debajo del pliegue
  // (la home) el diferido sigue siendo lo correcto.
  eager?: boolean;
}

const { eager = false } = Astro.props;

const shots = [
  { src: '/screenshots/panel.jpg', alt: 'Panel de métricas de Livvo', layer: 'back' },
  { src: '/screenshots/embudo.jpg', alt: 'Embudo de negocios de Livvo', layer: 'mid' },
  { src: '/screenshots/bandeja.jpg', alt: 'Bandeja de conversaciones de WhatsApp de Livvo', layer: 'front' },
];
---

<div class="stack" aria-label="Pantallas de la plataforma Livvo">
  <span class="stack__glow" aria-hidden="true"></span>
  {
    shots.map(({ src, alt, layer }, i) => (
      <figure class:list={['stack__shot', `stack__shot--${layer}`]}>
        <img
          {src}
          {alt}
          width="1568"
          height="652"
          loading={eager || layer === 'front' ? 'eager' : 'lazy'}
          decoding="async"
        />
      </figure>
    ))
  }
</div>

<style>
  .stack {
    position: relative;
    width: 100%;
    /* alto suficiente para la cascada de tres capas */
    padding-bottom: 74%;
  }

  /* halo teal detrás de las capas, como en el resto del DS */
  .stack__glow {
    position: absolute;
    inset: 12% -8% 18% 4%;
    background: radial-gradient(
      ellipse at 50% 50%,
      color-mix(in srgb, var(--teal) 22%, transparent),
      transparent 70%
    );
    filter: blur(28px);
    pointer-events: none;
  }

  .stack__shot {
    position: absolute;
    margin: 0;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    background: var(--white);
    /* entrada escalonada + flotación en bucle */
    animation:
      stack-in 0.7s ease both,
      stack-float 8s ease-in-out infinite alternate;
  }
  .stack__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .stack__shot--back {
    top: 0;
    left: 14%;
    width: 86%;
    opacity: 0.85;
    animation-delay: 0.15s, 0.6s;
  }
  .stack__shot--mid {
    top: 26%;
    left: 4%;
    width: 90%;
    animation-duration: 0.7s, 9.5s;
    animation-delay: 0.3s, 0s;
  }
  .stack__shot--front {
    top: 52%;
    left: 0;
    width: 100%;
    box-shadow: var(--shadow-hover);
    animation-duration: 0.7s, 7s;
    animation-delay: 0.45s, 1.2s;
  }

  @keyframes stack-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
    }
  }
  @keyframes stack-float {
    from { transform: translateY(-6px); }
    to { transform: translateY(6px); }
  }

  @media (max-width: 900px) {
    .stack { padding-bottom: 68%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack__shot {
      animation: none;
    }
  }
</style>
