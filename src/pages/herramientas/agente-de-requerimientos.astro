---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import Section from '../../components/Section.astro';
import Conversation from '../../components/Conversation.astro';

// Bot propio de este recurso (distinto al WhatsApp comercial de Livvo en config.ts):
// ya busca requerimientos en los portales inmobiliarios de Colombia y responde por WhatsApp.
const BOT_NUMBER = '12053048641';
const BOT_MESSAGE = 'Hola, quiero probar el Agente de Requerimientos de Livvo';
const BOT_URL = `https://wa.me/${BOT_NUMBER}?text=${encodeURIComponent(BOT_MESSAGE)}`;

const stats = [
  { value: '30 min', label: 'Tiempo promedio buscando un requerimiento a mano' },
  { value: '40%', label: 'De la jornada de un asesor dedicada a esta búsqueda' },
  { value: 'Segundos', label: 'Lo que tarda el agente en buscar en los portales' },
];

const steps = [
  {
    n: '01',
    title: 'Envía el requerimiento',
    desc: 'Escríbele al agente por WhatsApp lo que busca tu cliente: zona, presupuesto y tipo de propiedad.',
  },
  {
    n: '02',
    title: 'El agente busca por ti',
    desc: 'Revisa automáticamente los principales portales inmobiliarios de Colombia.',
  },
  {
    n: '03',
    title: 'Recibe las opciones',
    desc: 'Te llegan las propiedades que más se acercan al requerimiento, listas para compartir con tu cliente.',
  },
];

const turns = [
  { from: 'client', text: 'Busco apartamento en Chapinero, 3 alcobas, hasta $450M' },
  { from: 'reasoning', label: 'Buscando en portales inmobiliarios' },
  {
    from: 'luisa',
    label: 'Agente de Requerimientos',
    text:
      'Encontré 100 propiedades que coinciden con tu requerimiento. Estas son las 5 más cercanas:\n' +
      '• Chapinero Alto · 3 alcobas · $430M (Fincaraíz)\n' +
      '• Chapinero Central · 3 alcobas · $445M (Metrocuadrado)\n' +
      '• Chapinero Norte · 3 alcobas · $420M (Ciencuadras)\n' +
      '• Chapinero Alto · 3 alcobas · $438M (Fincaraíz)\n' +
      '• Chicó Norte · 3 alcobas · $449M (Metrocuadrado)',
  },
  {
    from: 'luisa',
    label: 'Agente de Requerimientos',
    text: '¿Quieres que te envíe las 100 propiedades completas? Escríbeme tu correo y te las mando.',
  },
];
---

<Base
  title="Agente de Requerimientos — Livvo"
  description="Envía el requerimiento de tu cliente por WhatsApp y recibe las propiedades que más se acercan, buscadas automáticamente en los principales portales inmobiliarios de Colombia."
  noindex
>
  <Navbar />

  <main>
    <!-- HERO -->
    <header class="ar-hero">
      <div class="container-site ar-hero__inner">
        <div class="ar-hero__copy">
          <span class="ar-hero__badge">Herramienta gratuita de Livvo</span>
          <h1>Agente de <span class="grad-text">Requerimientos</span></h1>
          <p class="ar-hero__sub">
            Envía el requerimiento de tu cliente por WhatsApp y recibe las propiedades que más se
            acercan, buscadas automáticamente en los principales portales inmobiliarios de
            Colombia.
          </p>
          <div class="ar-hero__ctas">
            <Button href={BOT_URL} target="_blank" size="lg" id="ar-hero-cta">
              Buscar por WhatsApp →
            </Button>
          </div>
        </div>

        <div class="ar-hero__visual">
          <Conversation turns={turns} animated />
        </div>
      </div>
    </header>

    <!-- STATS -->
    <Section alt>
      <div class="ar-stats fade-up">
        {stats.map(({ value, label }) => (
          <div class="ar-stat">
            <div class="ar-stat__value">{value}</div>
            <p class="ar-stat__label">{label}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CÓMO FUNCIONA -->
    <Section eyebrow="Cómo funciona" title="Tres pasos, todo por WhatsApp.">
      <ol class="ar-timeline fade-up">
        {steps.map(({ n, title, desc }) => (
          <li class="ar-timeline__step">
            <span class="ar-timeline__marker" aria-hidden="true"></span>
            <span class="ar-timeline__num">{n}</span>
            <h3 class="ar-timeline__title">{title}</h3>
            <p class="ar-timeline__desc">{desc}</p>
          </li>
        ))}
      </ol>
    </Section>

    <!-- CTA FINAL -->
    <Section alt eyebrow="Pruébalo" title="Busca tu próximo requerimiento ahora mismo">
      <div class="ar-cta fade-up">
        <p>
          Escríbele al agente por WhatsApp con un requerimiento real y mira las opciones que
          encuentra en segundos.
        </p>
        <Button href={BOT_URL} target="_blank" size="lg" id="ar-cta-final">
          Buscar por WhatsApp →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  /* ---- Hero ---- */
  .ar-hero {
    padding: 96px 0 40px;
    overflow: hidden;
  }
  .ar-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-10);
  }
  .ar-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 199, 180, 0.4);
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.08);
  }
  .ar-hero h1 {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 0 0 16px;
  }
  .ar-hero__sub {
    color: var(--muted);
    font-size: 18px;
    line-height: var(--lh-body);
    max-width: 480px;
    margin: 0 0 32px;
  }
  .ar-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- Stats ---- */
  .ar-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    text-align: center;
  }
  .ar-stat__value {
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: 700;
    background: var(--grad-flow);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
    margin-bottom: 10px;
  }
  .ar-stat__label {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    max-width: 260px;
    margin: 0 auto;
  }

  /* ---- Timeline ---- */
  .ar-timeline {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    margin: 0;
    padding: 0;
  }
  .ar-timeline__step {
    position: relative;
    padding-top: var(--space-8);
  }
  .ar-timeline__step::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: calc(-1 * var(--space-8));
    height: 1px;
    background: var(--border);
  }
  .ar-timeline__step:last-child::before { right: 0; }
  .ar-timeline__marker {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--teal-deep);
  }
  .ar-timeline__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: var(--ls-label);
    color: var(--teal-deep);
    margin-bottom: var(--space-2);
  }
  .ar-timeline__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .ar-timeline__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  /* ---- CTA final ---- */
  .ar-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .ar-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .ar-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-8);
    }
    .ar-hero__sub { margin-inline: auto; }
    .ar-hero__ctas { justify-content: center; }
    .ar-stats { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 900px) {
    .ar-timeline { grid-template-columns: 1fr; gap: 0; }
    .ar-timeline__step {
      padding: 0 0 var(--space-8) var(--space-8);
    }
    .ar-timeline__step::before {
      top: 0;
      left: 7px;
      right: auto;
      bottom: 0;
      width: 1px;
      height: auto;
    }
    .ar-timeline__step:last-child::before { display: none; }
  }
  @media (max-width: 768px) {
    .ar-hero { padding: 88px 0 40px; }
    .ar-hero h1 { font-size: 34px; }
  }
</style>
