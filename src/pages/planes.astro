---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';

// Iteración 5 (22 sep 2026) — un solo plan "Estándar" (antes "Crece"), sin Corporativo
// ni tarjeta de implementación aparte. Precio en COP (moneda real de cobro — Wompi solo
// factura en COP, ver autopago del CRM) con un "≈ US$" de referencia debajo, mismo
// lenguaje visual que facilia.app/pricing (precio grande + conversión pequeña al lado,
// CTA junto al precio). Tasa de referencia: TRM ~$3.193 COP/USD (sep-2026), redondeada.
// Fórmula: $45.000 + $154.000 × asesores — el piso en 1 asesor queda en $199.000. La
// fórmula NO se muestra al cliente, solo el resultado. Detalle: pricing_livvo.md §8.
const ESTANDAR_BASE = 45000;
const ESTANDAR_PER_SEAT = 154000;
const ESTANDAR_ANNUAL_DISCOUNT = 0.8;
const USD_COP_RATE = 3200;
---

<Base
  title="Planes y precios — Livvo"
  description="Un solo plan de autoservicio que crece con tu equipo. Luisa IA y CRM inmobiliario incluidos, sin límite de conversaciones."
>
  <Navbar />

  <main>
    <Section id="precios" eyebrow="Planes" title="Paga por lo que tu equipo realmente usa.">
      <div class="billing-toggle fade-up" role="group" aria-label="Periodicidad de facturación">
        <button type="button" class="billing-toggle__btn is-active" data-billing="monthly">
          Mensual
        </button>
        <button type="button" class="billing-toggle__btn" data-billing="annual">
          Anual <span class="billing-toggle__badge">Ahorra 20 %</span>
        </button>
      </div>

      <div class="pricing-single fade-up">
        <!-- ESTÁNDAR — único plan, calculadora en vivo por asesor -->
        <div class="seat-card">
          <div class="seat-card__top">
            <div>
              <div class="seat-card__name">Estándar</div>
              <p class="seat-card__tagline">Un plan para todo tu equipo. Sin límite de conversaciones.</p>
            </div>
            <div class="seat-card__cta">
              <Button variant="primary" href={WHATSAPP_URL} target="_blank">Comenzar ahora →</Button>
            </div>
          </div>

          <div class="seat-card__price">
            <span class="seat-card__amount" id="seat-price">$353.000</span>
            <span class="seat-card__period" id="seat-period">COP / mes</span>
          </div>
          <p class="seat-card__usd" id="seat-price-usd">≈ US$110/mes</p>

          <div class="seat-stepper">
            <span class="seat-stepper__label">Asesores</span>
            <div class="seat-stepper__control">
              <button type="button" id="seat-dec" aria-label="Quitar un asesor">−</button>
              <span class="seat-stepper__value" id="seat-count">2</span>
              <button type="button" id="seat-inc" aria-label="Sumar un asesor">+</button>
            </div>
          </div>

          <hr class="seat-card__divider" />
          <p class="seat-card__includes">Todo lo que incluye</p>
          <ul class="seat-card__features">
            <li><span class="seat-card__check">✓</span>Luisa IA responde, califica y agenda citas — 24/7</li>
            <li><span class="seat-card__check">✓</span>Recomienda propiedades y hace seguimiento</li>
            <li><span class="seat-card__check">✓</span>Conversaciones, negocios y propiedades en un solo lugar</li>
            <li><span class="seat-card__check">✓</span>Campañas de marketing por WhatsApp</li>
            <li><span class="seat-card__check">✓</span>Agenda inteligente de visitas y citas</li>
            <li><span class="seat-card__check">✓</span>Panel de métricas personalizadas</li>
            <li><span class="seat-card__check">✓</span>Fichas de propiedad y portafolio web</li>
          </ul>
        </div>
      </div>

      <div class="pricing-terms fade-up">
        <span>Prueba gratuita de 15 días</span>
        <span>Sin tarjeta de crédito</span>
        <span>Sin permanencia mínima</span>
        <span>Facturación en pesos colombianos</span>
      </div>
      <p class="pricing-fineprint fade-up">
        El precio de Estándar escala con la cantidad de asesores de tu equipo — no con el número de conversaciones. Luisa IA no tiene límite de conversaciones. El cobro es en pesos colombianos; el valor en dólares es solo de referencia.
      </p>
      <div class="pricing-cta fade-up">
        <p>¿No sabes cuántos asesores necesitas? Te ayudamos a elegir.</p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg">Prueba 15 días gratis →</Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<script define:vars={{ ESTANDAR_BASE, ESTANDAR_PER_SEAT, ESTANDAR_ANNUAL_DISCOUNT, USD_COP_RATE }}>
  // Toggle mensual/anual — mismo interruptor visual que antes, ahora también recalcula
  // el precio por asesor de Estándar en vez de solo swapear un dato estático.
  const billingBtns = Array.from(document.querySelectorAll('[data-billing]'));
  let isAnnual = false;

  const fmtCop = (n) => '$' + Math.round(n).toLocaleString('es-CO');
  const fmtUsd = (n) => '$' + Math.round(n).toLocaleString('en-US');
  const seatCountEl = document.getElementById('seat-count');
  const seatPriceEl = document.getElementById('seat-price');
  const seatPeriodEl = document.getElementById('seat-period');
  const seatPriceUsdEl = document.getElementById('seat-price-usd');
  const seatDecBtn = document.getElementById('seat-dec');
  const seatIncBtn = document.getElementById('seat-inc');
  let seats = 2;

  function renderSeatPrice() {
    seatCountEl.textContent = String(seats);
    const monthly = ESTANDAR_BASE + ESTANDAR_PER_SEAT * seats;
    const total = isAnnual ? monthly * ESTANDAR_ANNUAL_DISCOUNT : monthly;
    seatPriceEl.textContent = fmtCop(total);
    seatPeriodEl.textContent = isAnnual ? 'COP / mes · pago anual' : 'COP / mes';
    seatPriceUsdEl.textContent = '≈ US' + fmtUsd(total / USD_COP_RATE) + '/mes';
  }

  seatDecBtn.addEventListener('click', () => {
    seats = Math.max(1, seats - 1);
    renderSeatPrice();
  });
  seatIncBtn.addEventListener('click', () => {
    seats = Math.min(60, seats + 1);
    renderSeatPrice();
  });

  billingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      isAnnual = btn.dataset.billing === 'annual';
      billingBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      renderSeatPrice();
    });
  });

  renderSeatPrice();
</script>

<style>
  .billing-toggle {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    width: fit-content;
    margin: calc(-1 * var(--space-6)) auto var(--space-8);
    padding: 4px;
    background: var(--gray-bg);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .billing-toggle__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
    background: transparent;
    border: none;
    border-radius: 999px;
    padding: 8px 18px;
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition),
      box-shadow var(--transition);
  }
  .billing-toggle__btn.is-active {
    background: var(--white);
    color: var(--navy);
    box-shadow: var(--shadow-sm);
  }
  .billing-toggle__badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.1);
    border: 1px solid rgba(0, 199, 180, 0.4);
    border-radius: 20px;
    padding: 2px 8px;
  }

  .pricing-single {
    display: flex;
    justify-content: center;
  }

  /* --- tarjeta Estándar: precio + CTA en la misma fila, estilo facilia.app/pricing --- */
  .seat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 720px;
    background: var(--white);
    border: 2px solid var(--teal);
    box-shadow: var(--shadow-glow);
    border-radius: var(--radius-card);
    padding: var(--space-8);
  }
  .seat-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .seat-card__name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--navy);
  }
  .seat-card__tagline { font-size: var(--text-small); color: var(--muted); margin-top: var(--space-1); }
  .seat-card__cta :global(.btn) { white-space: nowrap; }

  .seat-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .seat-card__amount {
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
  }
  .seat-card__period { font-size: 15px; font-weight: 400; color: var(--muted); }
  .seat-card__usd { font-size: 13px; color: var(--muted); margin-top: 2px; }

  .seat-stepper {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-4);
    background: var(--gray-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-btn);
    max-width: 280px;
  }
  .seat-stepper__label { font-size: 13px; font-weight: 700; color: var(--navy); }
  .seat-stepper__control { display: flex; align-items: center; gap: var(--space-3); }
  .seat-stepper__control button {
    width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid var(--border); background: var(--white); color: var(--navy);
    font-size: 16px; font-weight: 700; line-height: 1; cursor: pointer;
  }
  .seat-stepper__control button:hover { border-color: var(--teal-deep); color: var(--teal-deep); }
  .seat-stepper__value {
    font-family: var(--font-mono); font-size: 16px; font-weight: 700;
    min-width: 18px; text-align: center; font-variant-numeric: tabular-nums;
  }

  .seat-card__divider { border: none; border-top: 1px solid var(--border); margin: var(--space-6) 0; }
  .seat-card__includes {
    font-size: 11px; font-weight: 700; letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--muted); margin: 0 0 var(--space-4);
  }
  .seat-card__features {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-6);
    font-size: 14.5px;
  }
  .seat-card__features li { display: flex; gap: var(--space-2); }
  .seat-card__check { color: var(--teal); font-weight: 700; flex: none; }

  @media (max-width: 640px) {
    .seat-card__features { grid-template-columns: 1fr; }
    .seat-card__top { flex-direction: column; }
    .seat-card__cta :global(.btn) { width: 100%; }
  }

  .pricing-terms {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-top: var(--space-12);
    font-size: 13px;
    color: var(--muted);
  }
  .pricing-fineprint {
    text-align: center;
    max-width: 620px;
    margin: var(--space-4) auto 0;
    font-size: 12px;
    color: var(--muted);
    opacity: 0.8;
  }
  .pricing-cta {
    text-align: center;
    max-width: 620px;
    margin: var(--space-12) auto 0;
    padding-top: var(--space-12);
    border-top: 1px solid var(--border);
  }
  .pricing-cta p {
    font-size: var(--text-body);
    color: var(--muted);
    margin: 0 0 var(--space-6);
  }
</style>
