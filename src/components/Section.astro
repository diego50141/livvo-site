---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  alt?: boolean; // fondo alterno (--gray-bg)
}

const { id, eyebrow, title, subtitle, alt = false } = Astro.props;
---

<section {id} class:list={['section', { 'section--alt': alt }]}>
  <div class="container-site">
    {
      (eyebrow || title) && (
        <div class="section__head fade-up">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2>{title}</h2>}
          {subtitle && <p class="section__subtitle">{subtitle}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section { padding: 96px 0; background: var(--white); transition: background-color var(--transition); }
  .section--alt { background: var(--gray-bg); }
  .section__head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--space-12);
  }
  /* mismo tamaño de título en TODAS las secciones */
  .section__head h2 {
    margin-top: var(--space-4);
    font-size: clamp(32px, 4vw, 44px);
    letter-spacing: -1px;
  }
  /* mismo tamaño de subtítulo en todas las secciones (--text-h2) */
  .section__subtitle {
    font-size: var(--text-h2);
    line-height: var(--lh-body);
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  @media (max-width: 768px) {
    .section { padding: 64px 0; }
  }
</style>
