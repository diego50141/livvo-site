---
import Button from './Button.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { WHATSAPP_URL } from '../config';

const links = [
  { href: '#funcionalidades', label: 'Funcionalidades' },
  { href: '#plataforma', label: 'Plataforma' },
  { href: '#integraciones', label: 'Integraciones' },
  // { href: '#precios', label: 'Precios' }, // restaurar junto con SHOW_PRICING (index.astro)
  { href: '#faq', label: 'Preguntas frecuentes' },
];

const tools = [
  { href: '/herramientas/calculadora-roi', label: 'Calculadora de ROI' },
];
---

<nav class="navbar">
  <div class="container-site navbar__inner">
    <a href="/" class="navbar__logo" aria-label="Livvo — inicio">
      <Logo size={26} />
    </a>
    <div class="navbar__links">
      {links.map(({ href, label }) => <a {href}>{label}</a>)}
      <div class="navbar__dropdown">
        <button class="navbar__droplink" type="button" aria-haspopup="true">
          Herramientas
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="navbar__menu">
          <div class="navbar__menu-card">
            {tools.map(({ href, label }) => <a {href}>{label}</a>)}
          </div>
        </div>
      </div>
    </div>
    <div class="navbar__actions">
      <ThemeToggle />
      <Button href="/ingresar" variant="ghost" size="sm" id="nav-login">
        Ingresar
      </Button>
      <Button
        href={WHATSAPP_URL}
        target="_blank"
        size="sm"
        id="nav-demo-cta"
      >
        Conversar con Livvo →
      </Button>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--white) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .navbar__logo { display: inline-flex; text-decoration: none; }
  .navbar__links { display: flex; gap: var(--space-8); }
  .navbar__links a {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .navbar__links a:hover { color: var(--navy); }

  /* Dropdown Herramientas (hover en desktop, focus para teclado) */
  .navbar__dropdown { position: relative; }
  .navbar__droplink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--transition);
  }
  .navbar__droplink svg { transition: transform var(--transition); }
  .navbar__dropdown:hover .navbar__droplink,
  .navbar__dropdown:focus-within .navbar__droplink { color: var(--navy); }
  .navbar__dropdown:hover .navbar__droplink svg,
  .navbar__dropdown:focus-within .navbar__droplink svg { transform: rotate(180deg); }
  .navbar__menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-top: 14px; /* puente invisible para no perder el hover */
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition), visibility var(--transition);
  }
  .navbar__dropdown:hover .navbar__menu,
  .navbar__dropdown:focus-within .navbar__menu {
    opacity: 1;
    visibility: visible;
  }
  .navbar__menu-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    padding: 6px;
    min-width: 210px;
  }
  .navbar__menu-card a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 14.5px;
    white-space: nowrap;
  }
  .navbar__menu-card a:hover { background: var(--surface); color: var(--navy); }

  .navbar__actions { display: flex; align-items: center; gap: var(--space-3); }
  @media (max-width: 768px) {
    .navbar__links { display: none; }
  }
</style>
