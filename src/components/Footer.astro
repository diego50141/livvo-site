---
import Logo from './Logo.astro';
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import { WHATSAPP_URL } from '../config';
---

<footer class="footer">
  <div class="container-site">
    <div class="footer__main">
      <!-- Izquierda: marca -->
      <div class="footer__col footer__brand">
        <Logo />
        <p class="footer__desc">
          Aumenta tu tasa de conversión de clientes potenciales con IA diseñada específicamente
          para el mercado inmobiliario.
        </p>
        <div class="footer__actions">
          <Button href={WHATSAPP_URL} target="_blank" size="sm">Conversar con Livvo →</Button>
        </div>
      </div>

      <!-- Centro: menú (antes vivía en el navbar) -->
      <nav class="footer__col footer__nav" aria-label="Menú del sitio">
        <h3 class="footer__nav-title">Menu</h3>
        <ul>
          <li><a href="/empleados-ia">Empleados IA</a></li>
          <li><a href="/plataforma-comercial">Plataforma Comercial</a></li>
          <li><a href="/#producto">Producto</a></li>
          <li><a href="/#integraciones">Integraciones</a></li>
          <li><a href="/#faq">Preguntas frecuentes</a></li>
        </ul>
      </nav>

      <!-- Herramientas (antes: dropdown del navbar) -->
      <nav class="footer__col footer__nav" aria-label="Herramientas">
        <h3 class="footer__nav-title">Herramientas</h3>
        <ul>
          <li><a href="/herramientas/calculadora-roi">Calculadora de ROI</a></li>
        </ul>
      </nav>

      <!-- Derecha: legal -->
      <nav class="footer__col footer__nav" aria-label="Enlaces legales">
        <h3 class="footer__nav-title">Legal</h3>
        <ul>
          <li><a href="/terminos-de-uso">Términos de uso</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>
        ©Livvo tecnologia S.A.S-Todos los derechos reservados
      </p>
      <ThemeToggle />
    </div>
  </div>
</footer>

<style>
  /* El footer sigue el tema: blanco en claro, oscuro en oscuro.
     Los tokens (--white/--text/--muted) se remapean solos con data-theme. */
  .footer {
    background: var(--white);
    color: var(--text);
    border-top: 1px solid var(--border);
    padding: 64px 0 40px;
    transition: background-color var(--transition), border-color var(--transition);
  }

  .footer__main {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
  }

  .footer__brand {
    gap: var(--space-6);
    max-width: 360px;
  }
  .footer__desc {
    font-size: var(--text-small);
    line-height: var(--lh-body);
    color: var(--muted);
    margin: 0;
  }

  .footer__nav {
    gap: var(--space-4);
  }

  .footer__nav-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--muted);
    margin: 0;
  }

  .footer__nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__nav a {
    font-size: var(--text-small);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footer__nav a:hover {
    color: var(--navy);
  }

  .footer__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .footer__bottom {
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .footer__bottom p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer__brand {
      max-width: none;
    }
    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
