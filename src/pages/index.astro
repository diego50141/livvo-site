        </figure>
      ))}
    </div>
    <div class="platform__cta fade-up">
      <Button href={CRM_LOGIN_URL} target="_blank" size="lg">Crea tu cuenta →</Button>
      <p>Sin tarjeta de crédito. Configura tu embudo y tu agente IA el mismo día.</p>
    </div>
  </Section>

  <!-- INTEGRACIONES -->
  <Section
    id="integraciones"
    eyebrow="Integraciones"
    title="Livvo se conecta con los sistemas que ya usas."
    subtitle="API pública, webhooks e importación de datos para que Livvo conviva con tu CRM o tus herramientas actuales."
  >
    <div class="connect-grid fade-up">
      {connectItems.map(({ icon, title, desc }) => (
        <article class="feature-card feature-card--admin">
          <span class="feature-card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={featureIcons[icon]}
            />
          </span>
          <h3 class="feature-card__title">{title}</h3>
          <p class="feature-card__desc">{desc}</p>
        </article>
      ))}
    </div>
    <p class="integrations__note fade-up">
      ¿Usas otro sistema? <a href={WHATSAPP_URL} target="_blank" rel="noopener">Cuéntanos</a> —
      te ayudamos a conectar Livvo con el stack que ya tienes.
    </p>
  </Section>

  <!-- PRECIOS (oculto por ahora — ver SHOW_PRICING) -->
  {SHOW_PRICING && (
  <Section id="precios" eyebrow="Planes" title="Empieza gratis. Escala cuando quieras.">
    <div class="pricing-grid fade-up">
      {
        plans.map((plan) => (
          <PricingCard
            name={plan.name}
            price={plan.price}
            period={plan.period}
            tagline={plan.tagline}
            features={plan.features}
            featured={plan.featured}
            ctaLabel={plan.ctaLabel}
            ctaHref={WHATSAPP_URL}
            ctaTarget="_blank"
          />
        ))
      }
    </div>
    <div class="setup-card fade-up">
      <div class="setup-card__info">
        <div class="setup-card__badge">Pago único · Mes 1</div>
        <div class="setup-card__name">Implementación inicial</div>
        <p class="setup-card__desc">
          Antes de activar tu plan configuramos y entrenamos tu Empleado IA y plataforma para que
          esté listo para trabajar.
        </p>
        <ul class="setup-card__features">
          <li><span class="setup-card__check">✓</span>Sesión de descubrimiento para entender tu negocio</li>
          <li><span class="setup-card__check">✓</span>Configuración y entrenamiento del Empleado IA</li>
          <li><span class="setup-card__check">✓</span>Integración con tu WhatsApp</li>
          <li><span class="setup-card__check">✓</span>Incluye 500 conversaciones el primer mes</li>
        </ul>
      </div>
      <div class="setup-card__price-box">
        <span class="setup-card__from">desde</span>
        <div class="setup-card__price">$1.199.000</div>
        <span class="setup-card__period">COP · pago único</span>
      </div>
    </div>
    <div class="pricing-terms fade-up">
      <span>Prueba gratuita de 7 días</span>
      <span>Sin tarjeta de crédito</span>
      <span>Facturación en pesos colombianos</span>
    </div>
  </Section>
  )}

  <!-- FAQ (alternancia: Plataforma es alt, Integraciones normal, FAQ alt) -->
  <Section id="faq" eyebrow="FAQ" title="Preguntas frecuentes" subtitle={faqSubtitle} alt>
    <div class="fade-up">
      <FAQ items={faqItems} />
      <div class="faq-footer fade-up">
        <p>Contáctanos si tienes alguna pregunta o problema.</p>
        <Button href={WHATSAPP_URL} target="_blank" variant="primary">Conversar con Livvo →</Button>
      </div>
    </div>
  </Section>
  </main>

  <Footer />
</Base>

<script>
  // Partículas teal del DS: pocas, pequeñas, deriva lenta y parpadeo sutil.
  // Sin top-level await: si algo falla o se cuelga, no bloquea el módulo.
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  const initParticles = async () => {
    await loadSlim(tsParticles);
    await tsParticles.load({
      id: 'hero-particles',
      options: {
        fullScreen: { enable: false },
        background: { color: 'transparent' },
        fpsLimit: 60,
        detectRetina: true,
        particles: {
          number: { value: 18, density: { enable: false } },
          color: { value: '#00C7B4' },
          shape: { type: 'circle' },
          opacity: {
            value: { min: 0.3, max: 0.8 },
            animation: { enable: true, speed: 0.5, sync: false },
          },
          size: { value: { min: 4, max: 7 } },
          shadow: { enable: true, color: '#00C7B4', blur: 18, offset: { x: 0, y: 0 } },
          move: {
            enable: true,
            speed: 0.35,
            direction: 'none',
            random: true,
            straight: false,
            outModes: { default: 'out' },
          },
        },
        interactivity: {
          events: { onHover: { enable: false }, onClick: { enable: false }, resize: { enable: true } },
        },
      },
    });
  };

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    initParticles().catch((e) => console.error('[particles] error:', e));
  }
</script>

<script>
  // Sección "cómo funciona": el contenedor mide 300vh y el contenido queda
  // sticky; el progreso de scroll decide qué paso está activo y los paneles
  // se cruzan con fade + desplazamiento (transiciones CSS → fluido).
  const stepsSection = document.getElementById('como-funciona');
  const stepPanels = Array.from(document.querySelectorAll('[data-step-panel]'));
  const stepDots = Array.from(document.querySelectorAll('[data-step-dot]'));
  const stepsReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stepsSection && stepPanels.length && stepsReduced) {
    // sin animación: pasos apilados, todos visibles
    stepsSection.classList.add('steps--static');
  } else if (stepsSection && stepPanels.length) {
    let stepsTicking = false;

    const updateSteps = () => {
      stepsTicking = false;
      const rect = stepsSection.getBoundingClientRect();
      const scrollable = rect.height - innerHeight;
      if (scrollable <= 0) return;
      const progress = Math.min(1, Math.max(0, -rect.top / scrollable));
      // reparte el progreso en tramos iguales por paso
      const idx = Math.min(stepPanels.length - 1, Math.floor(progress * stepPanels.length));

      stepPanels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === idx);
        panel.classList.toggle('is-past', i < idx);
      });
      stepDots.forEach((dot, i) => dot.classList.toggle('is-active', i === idx));
    };

    addEventListener(
      'scroll',
      () => {
        if (!stepsTicking) {
          stepsTicking = true;
          requestAnimationFrame(updateSteps);
        }
      },
      { passive: true }
    );
    updateSteps();
  }
</script>

<script>
  // Escena hero → teléfono ligada al scroll (estilo useplaza):
  // el teléfono asoma en la primera pantalla y sube/escala mientras
  // el texto del hero se desvanece. Sin librerías: scroll + rAF.
  const stage = document.getElementById('chat-stage');
  const heroContent = document.getElementById('hero-content');
  const rings = document.getElementById('chat-rings');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && heroContent && !reducedMotion) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const progress = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.55)));
      const eased = 1 - Math.pow(1 - progress, 2); // ease-out

      stage.style.transform = `translateY(${(1 - eased) * 90}px) scale(${0.9 + eased * 0.1})`;
      stage.style.opacity = String(0.5 + eased * 0.5);

      heroContent.style.opacity = String(1 - eased * 0.9);
      heroContent.style.transform = `translateY(${-eased * 40}px)`;

      // los anillos ganan presencia y se expanden levemente con el scroll
      if (rings) {
        rings.style.opacity = String(0.4 + eased * 0.6);
        rings.style.transform = `translate(-50%, -50%) scale(${0.92 + eased * 0.08})`;
      }
    };

    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    // al terminar la entrada, soltar la animación CSS para que los estilos
    // inline del scroll tomen el control (una animación activa los pisa)
    heroContent.addEventListener(
      'animationend',
      () => {
        heroContent.style.animation = 'none';
        update();
      },
      { once: true }
    );
    update();
  }
</script>

