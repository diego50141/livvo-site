    id="plataforma"
    eyebrow="Plataforma"
    title="Un CRM inmobiliario incluido, no un extra."
    subtitle="Así se ve Livvo por dentro: la bandeja donde Luisa y tu equipo atienden, el embudo donde viven tus negocios y las métricas de tu operación."
    alt
  >
    <div class="platform fade-up">
      {platformShots.map(({ src, alt: shotAlt, title, desc, wide }) => (
        <figure class:list={['platform__shot', { 'platform__shot--wide': wide }]}>
