---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';

// Bloques con captura de producto: cada uno alterna el lado de la imagen.
// Las capturas viven en public/screenshots/ — si falta el archivo, el marco
// se sigue viendo y muestra el texto alternativo.
const showcase = [
  {
    title: 'Bandeja de entrada compartida',
    desc: 'Todas las conversaciones de WhatsApp de tu inmobiliaria en una sola bandeja: tu equipo ve lo que la IA responde, interviene cuando hace falta y nada depende del celular de un asesor.',
    img: '/screenshots/bandeja.jpg',
    alt: 'Bandeja de entrada compartida de Livvo con las conversaciones de WhatsApp del equipo',
  },
  {
    title: 'Ficha del cliente centralizada',
    desc: 'Cada conversación y punto de contacto quedan centralizados en una sola ficha para que la atención sea eficiente y personalizada, y no se pase ningún momento importante.',
    img: '/screenshots/ficha-cliente.jpg',
    alt: 'Ficha del cliente en la interfaz de Livvo, con la información del contacto y su historial de interacciones',
  },
  {
    title: 'Embudo de negocios',
    desc: 'Mira toda tu operación comercial de un vistazo: cada negocio en su etapa, con su valor y su próximo paso, desde el primer mensaje hasta el cierre.',
    img: '/screenshots/embudo.jpg',
    alt: 'Embudo de negocios de Livvo en vista kanban, con los negocios organizados por etapa',
  },
  {
    title: 'Panel de control en tiempo real',
    desc: 'Analíticas en vivo de toda tu operación: conversaciones, contactos nuevos, valor de los negocios abiertos y el rendimiento de tus difusiones y automatizaciones — en un solo panel.',
    img: '/screenshots/panel.jpg',
    alt: 'Panel de Livvo con analíticas en vivo: conversaciones activas, contactos nuevos, valor de negocios abiertos y gráficas de actividad',
  },
];

const features = [
  {
    icon: 'users',
    title: 'Contactos y negocios',
    desc: 'Cada lead queda registrado desde el primer mensaje, con su historial completo y los datos que tus Empleados IA capturan en la conversación.',
  },
  {
    icon: 'send',
    title: 'Campañas de WhatsApp',
    desc: 'Envía difusiones con plantillas aprobadas por Meta a tus contactos y audiencias, sin salir de la plataforma.',
  },
  {
    icon: 'link',
    title: 'Integración con CRM y ERP',
    desc: 'Conectada con los principales sistemas del mercado inmobiliario. Todo en un solo lugar.',
  },
  {
    icon: 'calendar-check',
    title: 'Calendario centralizado',
    desc: 'Gestiona citas, seguimientos y tareas con un calendario unificado integrado en la plataforma Livvo.',
  },
  {
    icon: 'home',
    title: 'Inventario de propiedades conectado',
    desc: 'Tu portafolio dentro de la plataforma: cuando un lead pregunta, Luisa recomienda propiedades reales de tu inventario, con fotos y ficha incluidas.',
  },
  {
    icon: 'zap',
    title: 'Automatizaciones y flujos',
    desc: 'Asigna leads, dispara seguimientos y mueve negocios de etapa automáticamente, con reglas que tú defines.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'calendar-check':
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 15h3M8 18h6"/>',
  send: '<path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15v3M12 10v8M17 6v12"/>',
  home: '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 8.5V21h14V8.5"/><path d="M9 21v-6h6v6"/>',
  zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
};
---

<Base
  title="Plataforma Comercial — Livvo"
  description="El CRM de administración de propiedades con IA: unifica las conversaciones con prospectos y residentes, y las tareas de toda tu cartera, en una sola plataforma."
>
  <Navbar />

  <main>
    <!-- HERO del producto -->
    <header class="product-hero">
      <div class="container-site product-hero__inner">
        <span class="product-hero__badge">Producto · Plataforma Comercial</span>
        <h1>
          El CRM de administración de propiedades <em class="grad-text">con IA</em> para
          inmobiliarias modernas
        </h1>
        <p class="product-hero__sub">
          La Plataforma Comercial de Livvo unifica todas las conversaciones con posibles clientes
          y residentes, así como las tareas asociadas, en toda tu cartera de propiedades.
          Potenciada con agentes IA especializados en el sector inmobiliario.
        </p>
        <div class="product-hero__ctas">
          <Button href={WHATSAPP_URL} target="_blank" size="lg" id="plataforma-demo-cta">
            Conversar con Livvo →
          </Button>
          <Button href="/empleados-ia" variant="ghost" size="lg">
            Ver los Empleados IA
          </Button>
        </div>
      </div>
    </header>

    <!-- PLATAFORMA CENTRALIZADA — bloques con captura -->
    <Section
      eyebrow="Plataforma de administración de propiedades centralizada"
      title="Una bandeja de entrada única para cada interacción con prospectos e inquilinos"
      subtitle="La Plataforma Comercial optimiza el proceso de atención al almacenar cada interacción en un perfil de cliente único y dinámico, y sincronizar todas las tareas programadas y citas en un calendario, brindando claridad y confianza."
      alt
    >
      <div class="showcase">
        {showcase.map(({ title, desc, img, alt }) => (
          <article class="showcase__row fade-up">
            <div class="showcase__copy">
              <h3 class="showcase__title">{title}</h3>
              <p class="showcase__desc">{desc}</p>
            </div>
            <figure class="showcase__frame">
              <span class="showcase__bar" aria-hidden="true">
                <i></i><i></i><i></i>
              </span>
              <img src={img} {alt} loading="lazy" decoding="async" />
            </figure>
          </article>
        ))}
      </div>
    </Section>

    <!-- QUÉ INCLUYE -->
    <Section
      eyebrow="Qué más incluye"
      title="Todo lo que tu operación necesita para convertir"
      subtitle="Los leads llegan calificados por tus Empleados IA; la plataforma le da a tu equipo el contexto y las herramientas para cerrarlos."
    >
      <div class="pfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="pfeature">
            <span class="pfeature__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={featureIcons[icon]}
              />
            </span>
            <h3 class="pfeature__title">{title}</h3>
            <p class="pfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Empieza" title="Conoce la plataforma con tu propia operación">
      <div class="product-cta fade-up">
        <p>
          Cuéntanos cómo trabaja tu inmobiliaria y te mostramos la plataforma configurada con tu
          embudo, tus etapas y tus Empleados IA.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="plataforma-cta-final">
          Conversar con Livvo →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .product-hero {
    padding: 140px 0 80px;
  }
  .product-hero__inner {
    max-width: 880px;
    text-align: center;
    margin-inline: auto;
  }
  .product-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 199, 180, 0.4);
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.08);
  }
  .product-hero h1 {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .product-hero h1 em {
    font-style: normal;
  }
  .product-hero__sub {
    color: var(--muted);
    font-size: 17px;
    line-height: var(--lh-body);
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .product-hero__ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Bloques copy + captura: la imagen alterna de lado en cada fila */
  .showcase {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }
  .showcase__row {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: var(--space-8, 48px);
  }
  .showcase__row:nth-child(even) .showcase__copy { order: 2; }
  .showcase__title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 var(--space-3, 12px);
  }
  .showcase__desc {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0;
  }
  .showcase__frame {
    position: relative;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--white);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .showcase__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding-inline: 12px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .showcase__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }
  .showcase__frame img {
    display: block;
    width: 100%;
    /* Reserva el alto de la captura para que el marco no salte al cargar */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    background: var(--surface);
  }

  .pfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .pfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: box-shadow var(--transition), border-color var(--transition),
      background-color var(--transition), transform var(--transition);
  }
  .pfeature:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    background: rgba(0, 199, 180, 0.07);
    border-color: rgba(0, 199, 180, 0.45);
  }
  .pfeature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    margin-bottom: var(--space-4);
    background: rgba(0, 199, 180, 0.1);
    color: var(--teal-deep);
    transition: background-color var(--transition), color var(--transition);
  }
  .pfeature:hover .pfeature__icon {
    background: var(--grad-cta);
    color: #fff;
  }
  .pfeature__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .pfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  .product-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .product-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .pfeatures { grid-template-columns: repeat(2, 1fr); }
    .showcase { gap: 56px; }
    .showcase__row { grid-template-columns: 1fr; gap: var(--space-6); }
    .showcase__row:nth-child(even) .showcase__copy { order: 0; }
  }
  @media (max-width: 640px) {
    .product-hero { padding: 120px 0 60px; }
    .product-hero h1 { font-size: 32px; }
    .showcase__title { font-size: 22px; }
    .pfeatures { grid-template-columns: 1fr; }
  }
</style>
