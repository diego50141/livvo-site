---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string; // ruta en /public; por defecto el OG genérico del sitio
  structuredData?: Record<string, unknown> | Record<string, unknown>[]; // JSON-LD extra de la página (Service, SoftwareApplication, FAQPage...)
  ogType?: 'website' | 'article';
  publishedTime?: Date; // solo og:type=article
  modifiedTime?: Date;
  ogImageAlt?: string;
  articleSection?: string; // solo og:type=article
  articleTags?: string[]; // solo og:type=article
}

const {
  title = 'Livvo — Agenda más citas sin crecer tu equipo',
  description =
    'Agentes de IA para inmobiliarias, constructoras y desarrolladoras que prospectan, agendan citas, envían propiedades, hacen cobranza y atienden arrendatarios en WhatsApp 24/7.',
  noindex = false,
  ogImage = '/og.png',
  structuredData,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  ogImageAlt = 'Livvo: agentes de IA y plataforma de WhatsApp para inmobiliarias',
  articleSection,
  articleTags = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Organization en todas las páginas indexables; el resto del schema (producto,
// FAQ, etc.) lo agrega cada página vía structuredData.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Livvo',
  legalName: 'Livvo Tecnologia SAS',
  url: 'https://livvo.tech',
  logo: new URL('/Livvo_logo.svg', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bogotá',
    addressCountry: 'CO',
  },
  sameAs: ['https://www.linkedin.com/company/livvoai'],
};

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="UukG6dFczPWGGKR6FOdoaMhaadYgY-G6_0s-eWPCh6U" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog de Livvo"
      href="/blog/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Livvo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    {ogType === 'article' && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      ogType === 'article' && (modifiedTime ?? publishedTime) && (
        <meta
          property="article:modified_time"
          content={(modifiedTime ?? publishedTime)!.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    {
      !noindex && (
        <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
      )
    }
    {
      extraSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&family=Geist+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Tema antes del primer paint para evitar flash -->
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const theme =
        stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>

    <!-- Analytics de terceros (Clarity + PostHog): se cargan tras la primera
         interacción o 3,5 s después del load, para no bloquear el hilo principal
         durante el render inicial. Al terminar emiten 'livvo:3p'. -->
    <script is:inline>
      window.__load3p = function () {
      if (window.__3pLoaded) return;
      window.__3pLoaded = true;
      // Microsoft Clarity (mismo proyecto que producción)
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vyssfzeld2");

      // PostHog (misma key que producción; pageview manual para incluir UTMs)
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="fi init Oi Fi ft Ii Ai Ri capture calculateEventProperties Ni register register_once register_for_session unregister unregister_for_session Hi getFeatureFlag getFeatureFlagPayload getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey displaySurvey cancelPendingSurvey canRenderSurvey canRenderSurveyAsync qi identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException startExceptionAutocapture stopExceptionAutocapture loadToolbar get_property getSessionProperty zi Li createPersonProfile setInternalOrTestUser Bi $i Wi opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent_status is_capturing clear_opt_in_out_capturing Mi debug bt ji getPageViewId captureTraceFeedback captureTraceMetric Si".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_ceAm5K3feQDk6H6LsN51uPC7YGFTMh8DdSxP8fMp8cE', {
        api_host:          'https://us.i.posthog.com',
        defaults:          '2026-01-30',
        person_profiles:   'identified_only',
        capture_pageview:  false,
        capture_pageleave: true,
        autocapture:       false,
      });
      document.dispatchEvent(new Event('livvo:3p'));
      };

      (function () {
        var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
        function fire() {
          events.forEach(function (e) { removeEventListener(e, fire); });
          window.__load3p();
        }
        events.forEach(function (e) { addEventListener(e, fire, { passive: true, once: true }); });
        addEventListener('load', function () { setTimeout(fire, 3500); });
      })();
    </script>

    <!-- Vercel Web Analytics -->
    <Analytics />
    <!-- Vercel Speed Insights: Core Web Vitals de usuarios reales (LCP, INP, CLS) -->
    <SpeedInsights />
  </head>
  <body>
    <slot />

    <script>
      function initFadeUp() {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0, rootMargin: '0px 0px -10% 0px' }
        );
        const elements = document.querySelectorAll('.fade-up');
        elements.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFadeUp);
      } else {
        initFadeUp();
      }
    </script>

    <!-- Eventos de analytics — paridad con la landing de producción -->
    <script>
      const currentTheme = () => document.documentElement.dataset.theme;

      // PostHog carga diferido (ver <head>): los eventos se registran cuando emite 'livvo:3p'.
      function initEvents() {
        const ph = (window as any).posthog;
        if (!ph) return;
        // page_viewed con UTMs (pageview manual)
        const utms = Object.fromEntries(
          [...new URLSearchParams(location.search)].filter(([key]) => key.startsWith('utm_'))
        );
        ph.capture('page_viewed', { ...utms, theme: currentTheme() });

        // demo_cta_clicked — los botones de demo terminan en "-demo-cta"
        document.querySelectorAll('[id$="demo-cta"]').forEach((cta) => {
          cta.addEventListener('click', () => {
            ph.capture('demo_cta_clicked', {
              cta_location: cta.id.replace('-demo-cta', ''),
              theme: currentTheme(),
            });
          });
        });

        // section_viewed — hasta dónde llega el scroll (una vez por sección)
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                ph.capture('section_viewed', { section: entry.target.id });
                sectionObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );
        document.querySelectorAll('section[id]').forEach((s) => sectionObserver.observe(s));

        // faq_opened — qué objeciones abre la gente (tras el toggle del acordeón)
        document.querySelectorAll('.faq__item').forEach((item) => {
          item.querySelector('.faq__q')?.addEventListener('click', () => {
            setTimeout(() => {
              if (item.classList.contains('open')) {
                const question = item
                  .querySelector('.faq__q')
                  ?.textContent?.replace(/\+\s*$/, '')
                  .trim();
                ph.capture('faq_opened', { question });
              }
            }, 0);
          });
        });

        // theme_toggled — para comparar conversión claro vs oscuro
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          setTimeout(() => ph.capture('theme_toggled', { theme: currentTheme() }), 0);
        });
      }

      if ((window as any).__3pLoaded) initEvents();
      else document.addEventListener('livvo:3p', initEvents, { once: true });
    </script>
  </body>
</html>
