---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import FAQ from '../components/FAQ.astro';
import DemoForm from '../components/DemoForm.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';
import fotoLuisa from '../assets/equipo/luisa.png';

// Orden de la home: problema → Luisa (IA) → Livvo Chat (plataforma) →
// plataforma completa (los dos juntos, con CTA a cada uno).
// El servicio administrado ("Livvo Administración") y el resto del equipo IA
// (Lucía, Laura, Lina, Lorena, Liliana) quedan fuera del home: el equipo vive
// en /agentes-ia, al que se llega desde el cierre de la sección de Luisa.
//
// Una familia de layout por sección (regla anti-plantilla): cifras, grilla de
// iconos, bento con capturas, lista a dos columnas, marquesina, CTA y
// acordeón. Ninguna se repite.

// El problema del sector: tres dolores concretos, sin cifras protagonistas.
// Misma familia de tarjeta que el resto del sitio, con el chip circular
// en el acento rojo del problema.
const problemItems = [
  {
    icon: 'ph:robot',
    title: 'Tu equipo hace trabajo de máquina.',
    desc: '¿Cuántas alcobas tiene? ¿Dónde queda? ¿Cuánto vale la cuota inicial? Las mismas preguntas 50 veces al día en vez de cerrar negocios.',
    stat: '4 h',
    statLabel: 'perdidas al día por asesor',
  },
  {
    icon: 'ph:calendar-x',
    title: 'Las visitas se agendan, pero no se cumplen.',
    desc: 'Sin confirmación automática ni recordatorios, tus asesores pierden tiempo esperando clientes que no llegan.',
    stat: '3/10',
    statLabel: 'citas agendadas se cumplen',
  },
  {
    icon: 'ph:snowflake',
    title: 'Los leads se enfrían antes del seguimiento.',
    desc: 'Clientes que estaban listos para comprar se enfriaron porque nadie les hizo seguimiento a tiempo.',
    stat: '1%',
    statLabel: 'de los leads se convierte en negocio',
  },
];

// Luisa: seis capacidades, en el orden real de una conversación
// (responder → calificar → recomendar → agendar → seguir → escalar).
const luisaSkills = [
  {
    icon: 'ph:clock',
    title: 'Responde en segundos, 24/7',
    desc: 'Nunca deja a un lead esperando. Madrugada, domingo o festivo: la primera respuesta llega en segundos y con el tono de tu marca.',
  },
  {
    icon: 'ph:funnel',
    title: 'Califica cada lead',
    desc: 'Pregunta por operación, presupuesto, zona y forma de pago, y arma el perfil completo antes de que un asesor invierta un minuto.',
  },
  {
    icon: 'ph:house-line',
    title: 'Recomienda propiedades',
    desc: 'Busca en tu portafolio y envía las opciones que encajan con lo que el cliente pidió, con fotos, precio y detalles.',
  },
  {
    icon: 'ph:calendar-check',
    title: 'Agenda la visita',
    desc: 'Cierra la cita en la misma conversación, la sincroniza con Google Calendar y después confirma y recuerda.',
  },
  {
    icon: 'ph:target',
    title: 'Rescata leads fríos',
    desc: 'Retoma a quien dejó de responder con seguimientos programados, en vez de dejar que el negocio se enfríe solo.',
  },
  {
    icon: 'ph:hand-arrow-up',
    title: 'Escala a tu asesor',
    desc: 'Cuando detecta intención real de compra o algo que no sabe, pasa la conversación a un humano con todo el contexto a la vista.',
  },
];

// Livvo Chat: seis módulos en grilla uniforme de 3 columnas, la misma
// familia de tarjeta que el resto del sitio.
const chatCells = [
  {
    icon: 'ph:tray',
    title: 'Bandeja compartida',
    desc: 'Todo el equipo atiende desde una sola bandeja: conversaciones asignables, notas internas, etiquetas e historial completo de cada cliente.',
  },
  {
    icon: 'ph:kanban',
    title: 'Embudo inmobiliario',
    desc: 'De lead nuevo a cierre ganado, con las etapas del sector y los valores en pesos.',
  },
  {
    icon: 'ph:buildings',
    title: 'Gestor de propiedades',
    desc: 'Tu portafolio y tus clientes centralizados. Es la base de la que Luisa saca sus recomendaciones.',
  },
  {
    icon: 'ph:megaphone-simple',
    title: 'Campañas y difusiones',
    desc: 'Envíos masivos por WhatsApp con plantillas aprobadas por Meta: nuevos proyectos, open house y seguimiento de cartera, con métricas de entrega.',
  },
  {
    icon: 'ph:chart-bar',
    title: 'Reportes de la operación',
    desc: 'Tiempos de respuesta, conversaciones atendidas, citas agendadas y negocios por asesor. Sabes qué está pasando sin preguntar.',
  },
  {
    icon: 'ph:lightning',
    title: 'Automatizaciones y API',
    desc: 'Reglas «si pasa X, haz Y», webhooks salientes y API pública para conectar Livvo con las herramientas que ya usas.',
  },
];

// Plataforma completa: el recap final con los dos productos y su CTA propio.
// Cada tarjeta abre con su ilustración de marca (las mismas del mega-menú).
const products = [
  {
    key: 'chat',
    name: 'Livvo Chat',
    desc: 'La plataforma que centraliza todas las conversaciones de WhatsApp y otros canales en un solo lugar, con múltiples agentes.',
    href: '/plataforma-de-atencion-al-cliente',
    external: false,
    illus: '/illustrations/livvo-chat-mega.png',
    illusAlt: 'Ilustración de la plataforma Livvo Chat',
  },
  {
    key: 'luisa',
    name: 'Luisa IA',
    desc: 'La inteligencia artificial que califica leads en tiempo real, agenda visitas automáticamente y mantiene tu inmobiliaria disponible 24 horas, 7 días a la semana.',
    href: '/agentes-ia',
    external: false,
    illus: '/illustrations/luisa-ia-mega.png',
    illusAlt: 'Ilustración de Luisa, la agente IA de Livvo',
  },
];

// Tecnología y seguridad: lista a dos columnas, sin tarjetas. Es una sección
// de confianza, no de producto: separadores finos en vez de cajas.
const techItems = [
  {
    icon: 'ph:whatsapp-logo',
    title: 'API oficial de WhatsApp Business',
    desc: 'Tu línea opera sobre la Meta Cloud API, no sobre soluciones no oficiales que ponen en riesgo tu número.',
  },
  {
    icon: 'ph:calendar-blank',
    title: 'Google Calendar integrado',
    desc: 'Integración nativa: coordinación de citas sin salir de Livvo.',
  },
  {
    icon: 'ph:cloud-check',
    title: 'Infraestructura en la nube',
    desc: 'Monitoreo 24/7. Tus agentes nunca dejan de trabajar.',
  },
  {
    icon: 'ph:database',
    title: 'Tus datos son tuyos',
    desc: 'Exportables vía API y alojados con seguridad de nivel empresarial.',
  },
  {
    icon: 'ph:clock-counter-clockwise',
    title: 'Historial completo de conversaciones',
    desc: 'Cada chat queda registrado y auditable. Nada se pierde, aunque un asesor se vaya.',
  },
  {
    icon: 'ph:shield-check',
    title: 'Roles y permisos por usuario',
    desc: 'Cada asesor ve lo suyo; tú tienes visibilidad de toda la operación.',
  },
];

// Inmobiliarias que usan Livvo — logos oficiales en public/clients/.
const clientLogos = [
  { name: 'DC Colombia', src: '/clients/dccolombia.svg', href: 'https://dccolombia.com.co' },
  { name: 'Casas y Espacios', src: '/clients/casasyespacios.webp', href: 'https://casasyespacios.co', tint: true },
  { name: 'Alborada', src: '/clients/alborada.png', href: 'https://alborada.co' },
  { name: 'Century 21 Colombia', src: '/clients/century21colombia.svg', href: 'https://century21colombia.com' },
  { name: 'LlanoCasa', src: '/clients/llanocasa.jpg', href: 'https://web.facebook.com/LlanoCasa/', round: true },
  { name: 'Morada Inmobiliaria', src: '/clients/morada.webp', href: 'https://site-6ym14pjxv.godaddysites.com/', round: true },
];

// Integraciones — logos oficiales en public/integrations/.
// Dos cintas: CRMs (arriba) y portales inmobiliarios (abajo).
const integrationRows = [
  [
    { name: 'HubSpot', cat: 'CRM', src: '/integrations/hubspot.svg' },
    { name: 'GoHighLevel', cat: 'CRM', src: '/integrations/gohighlevel.svg' },
    { name: 'Wasi', cat: 'CRM inmobiliario', src: '/integrations/wasi.svg' },
    { name: 'Domus', cat: 'CRM inmobiliario', src: '/integrations/domus.png' },
  ],
  [
    { name: 'Fincaraíz', cat: 'Portal', src: '/integrations/fincaraiz.png' },
    { name: 'Metrocuadrado', cat: 'Portal', src: '/integrations/metrocuadrado.png' },
    { name: 'Ciencuadras', cat: 'Portal', src: '/integrations/ciencuadras.svg' },
    { name: 'Century 21', cat: 'Red inmobiliaria', src: '/integrations/century21.svg' },
  ],
];

const faqItems = [
  {
    q: '¿Qué hace exactamente Livvo?',
    a: 'Livvo es una plataforma de atención al cliente e inteligencia artificial para agencias inmobiliarias. Luisa, la agente de inteligencia artificial que atiende, califica y agenda por WhatsApp 24/7, y Livvo Chat, la plataforma donde tu equipo gestiona conversaciones, propiedades y negocios en un solo lugar con automatizaciones integradas',
  },
  {
    q: '¿Puedo usar la plataforma sin la IA?',
    a: 'Sí. Livvo Chat funciona por sí solo como plataforma de atención al cliente: bandeja compartida, embudo, propiedades, automatizaciones y campañas. Luisa se activa cuando quieras, y a partir de ahí trabaja sobre esa misma base. Por eso el resultado es mucho mejor con los dos que con uno solo.',
  },
  {
    q: '¿La IA reemplaza a mis asesores?',
    a: 'No. Imagínala como una primera línea que nunca duerme: Luisa responde, califica, envia propiedades y agenda; tus asesores entran cuando hay una visita que atender o un negocio que cerrar, con todo el historial de la conversación a la vista, y pueden intervenir en cualquier momento si lo ven necesario.',
  },
  {
    q: '¿Qué pasa si la IA no sabe responder algo?',
    a: 'Escala la conversación a un asesor humano en el mismo chat, sin que el cliente tenga que repetir nada.',
  },
  {
    q: '¿Sirve solo para atención al cliente y venta, o también para arriendos y postventa?',
    a: 'También. Además de Luisa hay agentes IA especializados en servicio, administración, cobranza, jurídico y escrituración. Puedes conocerlos en la página de Agentes IA.',
  },

  {
    q: '¿Puedo seguir usando el número de WhatsApp que ya tiene mi inmobiliaria?',
    a: 'Sí, migramos tu línea actual a WhatsApp Business API para que tus clientes sigan escribiendo al mismo número, y todo el equipo atiende desde una bandeja compartida en vez de desde celulares sueltos.',
  },
  {
    q: '¿De quién son los contactos y las conversaciones?',
    a: 'De tu inmobiliaria. Contactos, historial y negocios viven en la plataforma, no en el celular del asesor: si alguien se va del equipo, la relación con el cliente se queda.',
  },
  {
    q: '¿Cuánto tiempo toma implementarlo?',
    a: 'Entre 3 y 5 días dependiendo de la personalización. Incluye entrenamiento del agente y conexión con WhatsApp Business API.',
  },
  {
    q: '¿De qué depende el precio?',
    a: 'Del volumen de conversaciones al mes, del número de propiedades que administres y de cuántos usuarios de tu equipo entran a la plataforma.',
  }
];

---

<Base
  title="Livvo: agenda más visitas sin contratar más asesores"
  description="Livvo son dos productos: Luisa, la agente de IA que atiende, califica y agenda citas por WhatsApp 24/7, y Livvo Chat, la plataforma donde tu equipo gestiona conversaciones, propiedades y negocios."
>
  <Navbar />

  <main>
  <!-- HERO: el paraguas, los dos productos en un solo lugar -->
  <div class="hero-scene theme-dark-scope">
    <header class="hero">
      <div class="container-site hero__inner">
        <div class="hero__content" id="hero-content">
          <span class="hero__badge">
            Automatización para <span class="hero__badge-word" id="hero-badge-word">inmobiliarias</span>
          </span>
          <h1 class="hero__title">
            Agenda más visitas. <em class="grad-text">Sin contratar más asesores.</em>
          </h1>
          <p class="hero__sub">
            <strong>Luisa</strong> atiende, califica y agenda 24/7.
            <strong>Livvo Chat</strong> es la plataforma que unifica la atención al cliente.
          </p>
          <div class="hero__ctas">
            <Button href={WHATSAPP_URL} target="_blank" size="lg" id="hero-demo-cta">Prueba 7 días gratis →</Button>
          </div>
        </div>
        <div class="hero__chat">
          <!-- Escena "explotada" de la plataforma (patrón Realmate): tarjetas
               flotantes que cuentan el recorrido lead → Luisa → visita agendada -->
          <img
            class="hero__scene"
            src="/illustrations/hero-plataforma.png"
            alt="La plataforma Livvo: Luisa responde, el equipo gestiona y la visita queda agendada"
            width="2200"
            height="860"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </header>
  </div>

  <!-- CLIENTES: cinta corrediza de logos, prueba social justo debajo del hero -->
  <div class="clients-strip fade-up">
    <div class="container-site">
      <p class="clients-strip__label">Inmobiliarias que ya confían en Livvo</p>
      <div class="clients-strip__marquee">
        <div class="clients-strip__track">
          {[0, 1].map((copy) => (
            <div class="clients-strip__group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {clientLogos.map(({ name, src, href, round, tint }) => (
                <a
                  class:list={['clients-strip__logo', { 'clients-strip__logo--round': round }]}
                  href={href}
                  target="_blank"
                  rel="noopener"
                  title={name}
                >
                  {tint ? (
                    <span
                      class="clients-strip__logo-mask"
                      style={`--logo-src:url(${src})`}
                      role="img"
                      aria-label={name}
                    />
                  ) : (
                    <img src={src} alt={name} loading="lazy" />
                  )}
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- EL PROBLEMA: cabecera estándar + tres tarjetas con chip circular rojo -->
  <Section
    id="problema"
    eyebrow="El problema"
    title="Tu operación comercial está fragmentada."
  >
    <div class="problem-grid fade-up">
      {problemItems.map(({ icon, title, desc, stat, statLabel }) => (
        <article class="problem-card">
          <div class="problem-card__head">
            <Icon class="problem-card__icon" name={icon} width={20} height={20} aria-hidden="true" />
            <h3 class="problem-card__title">{title}</h3>
          </div>
          <p class="problem-card__desc">{desc}</p>
          <div class="problem-card__stat">
            <span class="problem-card__stat-value">
              {stat}
              <Icon name="ph:trend-down" width={17} height={17} aria-hidden="true" />
            </span>
            <span class="problem-card__stat-label">{statLabel}</span>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- LUISA: grilla de capacidades con icono. Única sección con esta familia -->
  <Section
    id="luisa"
    dark
    eyebrow="Inteligencia artificial"
    title="Conoce a Luisa, la agente que atiende por ti."
  >
    <div class="luisa-strip fade-up">
      <Image
        class="luisa-strip__photo"
        src={fotoLuisa}
        alt="Luisa, agente de IA de Livvo"
        width={220}
        densities={[1, 2]}
      />
      <div>
        <h3 class="luisa-strip__name">Luisa</h3>
        <span class="luisa-strip__rol">Agente de ventas y atención al cliente</span>
        <p class="luisa-strip__desc">
          Atiende por WhatsApp y por la web. Habla como tu equipo, conoce tu portafolio
          y no deja una sola consulta sin responder.
        </p>
      </div>
    </div>

    <ul class="skills-list fade-up">
      {luisaSkills.map(({ icon, title, desc }) => (
        <li class="skill-item">
          <Icon class="skill-item__icon" name={icon} width={20} height={20} aria-hidden="true" />
          <div>
            <h3 class="skill-item__title">{title}</h3>
            <p class="skill-item__desc">{desc}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="product-close fade-up">
      <div class="product-close__text">
        <h3 class="product-close__title">Luisa, tu nueva asistente virtual con IA.</h3>
        <p class="product-close__desc">
          Califica leads, agenda visitas y aumenta el número de citas de tu inmobiliaria
          con atención 24 horas, 7 días a la semana.
        </p>
      </div>
      <Button href="/agentes-ia" variant="outline" size="lg">Más información →</Button>
    </div>
  </Section>

  <!-- LIVVO CHAT: bento. Tres celdas con captura real, tres de texto -->
  <Section
    id="livvo-chat"
    dark
    eyebrow="Plataforma de atención al cliente"
    title="Livvo Chat: todo tu WhatsApp, ordenado."
  >
    <div class="bento fade-up">
      {chatCells.map(({ icon, title, desc }) => (
        <article class="bento__cell">
          <div class="bento__head">
            <Icon class="bento__icon" name={icon} width={20} height={20} aria-hidden="true" />
            <h3 class="bento__title">{title}</h3>
          </div>
          <p class="bento__desc">{desc}</p>
        </article>
      ))}
    </div>

    <div class="product-close fade-up">
      <div class="product-close__text">
        <h3 class="product-close__title">Unifica la atención al cliente de tu inmobiliaria.</h3>
        <p class="product-close__desc">
          Centraliza todas las conversaciones de WhatsApp en un solo lugar. Gestiona equipos,
          transfiere solicitudes y haz seguimiento de los resultados con una plataforma
          diseñada para el sector inmobiliario.
        </p>
      </div>
      <Button href="/plataforma-de-atencion-al-cliente" variant="outline" size="lg">
        Más información →
      </Button>
    </div>
  </Section>

  <!-- PLATAFORMA COMPLETA: los dos productos, cada uno con su CTA -->
  <Section
    id="plataforma-completa"
    dark
    eyebrow="Plataforma completa"
    title="Todo lo que tu inmobiliaria necesita para vender y atender."
  >
    <div class="product-grid fade-up">
      {products.map(({ key, name, desc, href, external, illus, illusAlt }) => (
        <article class:list={['product-card', `product-card--${key}`]}>
          <span class="product-card__illus">
            <img src={illus} alt={illusAlt} width="1280" height="580" loading="lazy" decoding="async" />
          </span>
          <h3 class="product-card__name">{name}</h3>
          <p class="product-card__desc">{desc}</p>
          <div class="product-card__cta">
            <Button href={href} target={external ? '_blank' : undefined} variant="outline">
              Más información →
            </Button>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- INTEGRACIONES: marquesina. Única del sitio en esta página -->
  <Section
    id="integraciones"
    dark
    eyebrow="Integraciones"
    title="Livvo se conecta con los sistemas que ya usas."
  >
    <div class="integrations fade-up">
      {integrationRows.map((row, i) => (
        <div class="integrations__marquee">
          <div class:list={['integrations__track', { 'integrations__track--reverse': i % 2 === 1 }]}>
            {[0, 1].map((copy) => (
              <div class="integrations__group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map(({ name, cat, src }) => (
                  <span class="integration-pill" title={`${name} · ${cat}`}>
                    <img class="integration-pill__logo" src={src} alt={name} loading="lazy" />
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="integrations__note">
        ¿Usas otro sistema? <a href={WHATSAPP_URL} target="_blank" rel="noopener">Cuéntanos</a>.
      </p>
    </div>
  </Section>

  <!-- TECNOLOGÍA: lista a dos columnas, sin tarjetas (sección de confianza) -->
  <Section
    id="tecnologia"
    dark
    eyebrow="Tecnología y seguridad"
    title="Tecnología en la que puedes confiar."
  >
    <ul class="trust-list fade-up">
      {techItems.map(({ icon, title, desc }) => (
        <li class="trust-item">
          <Icon class="trust-item__icon" name={icon} width={20} height={20} aria-hidden="true" />
          <div>
            <h3 class="trust-item__title">{title}</h3>
            <p class="trust-item__desc">{desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <!-- PLANES: oculta por ahora (patrón Realmate: sin pricing público en el
       home). La página /planes sigue existiendo; restaurar desde git si vuelve. -->

  <!-- AGENDA TU DEMO: formulario de HubSpot (patrón Nexiu) -->
  <DemoForm />

  <!-- FAQ: acordeón -->
  <Section id="faq" dark eyebrow="Preguntas frecuentes" title="Lo que nos preguntan antes de empezar.">
    <div class="fade-up">
      <FAQ items={faqItems} />
      <div class="faq-footer fade-up">
        <p>Contáctanos si tienes alguna pregunta o problema.</p>
        <Button href={WHATSAPP_URL} target="_blank" variant="primary">Prueba 7 días gratis →</Button>
      </div>
    </div>
  </Section>
  </main>

  <Footer />
</Base>

<script>
  // Badge del hero: la vertical rota entre los tres segmentos con un
  // crossfade breve; con reduced-motion el texto cambia sin animación.
  const badgeWord = document.getElementById('hero-badge-word');
  const badgeReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const verticals = ['inmobiliarias', 'constructoras', 'desarrolladoras inmobiliarias'];
  let verticalIdx = 0;

  if (badgeWord) {
    setInterval(() => {
      verticalIdx = (verticalIdx + 1) % verticals.length;
      if (badgeReduced) {
        badgeWord.textContent = verticals[verticalIdx];
        return;
      }
      badgeWord.classList.add('is-out');
      setTimeout(() => {
        badgeWord.textContent = verticals[verticalIdx];
        badgeWord.classList.remove('is-out');
      }, 250);
    }, 3000);
  }
</script>

<style>
  /* La escena contiene hero + chat y aporta el fondo oscuro del DS
     (ritmo dark/white tipo Nexiu: el hero abre en navy) */
  .hero-scene {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 15% 25%, rgba(0, 199, 180, 0.1) 0%, transparent 45%),
      radial-gradient(circle at 85% 75%, rgba(59, 126, 255, 0.08) 0%, transparent 45%),
      linear-gradient(180deg, #070b14 0%, #0a0e1a 100%);
  }

  .hero {
    display: flex;
    align-items: center;
    background: transparent;
    position: relative;
    z-index: 2;
    padding: 8vh 0 6vh;
  }
  /* Hero apilado (patrón Realmate): mensaje centrado arriba,
     escena panorámica de la plataforma debajo */
  .hero__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
