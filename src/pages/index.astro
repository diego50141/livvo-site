    ctaLabel: 'Conversar con Livvo →',
  },
];

// Conexión con otros sistemas — sin logos de terceros: lo que ofrecemos
// hoy es API pública, webhooks e import/export, y se explica tal cual.
const connectItems = [
  {
    icon: 'link',
    title: 'API pública',
    desc: 'Consulta y crea contactos, conversaciones y mensajes desde tus propios sistemas con una API REST documentada y llaves con permisos por alcance.',
  },
  {
    icon: 'chart',
    title: 'Webhooks en tiempo real',
    desc: 'Cada mensaje, lead o cambio de etapa puede notificarse al instante a tu CRM o a cualquier sistema que ya uses.',
  },
  {
    icon: 'filter',
    title: 'Importación de datos',
    desc: 'Trae tus contactos y audiencias por CSV en minutos. Tus datos son tuyos: entran y salen de Livvo sin fricción.',
  },
];

// Screenshots reales del producto (src/assets/screenshots/, optimizados por astro:assets).
const platformShots = [
