---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';
import fotoLuisa from '../assets/equipo/luisa.png';
import fotoLucia from '../assets/equipo/lucia.png';
import fotoLaura from '../assets/equipo/laura.png';
import fotoLina from '../assets/equipo/lina.jpg';
import fotoLorena from '../assets/equipo/lorena.jpg';
import fotoLiliana from '../assets/equipo/liliana.png';

const features = [
  {
    icon: 'ph:chat-circle-dots',
    title: 'Atención al cliente 24/7',
    desc: 'Luisa responde en segundos, con el tono de tu inmobiliaria, a inquilinos y propietarios en cualquier momento, también de noche y en fines de semana.',
  },
  {
    icon: 'ph:funnel',
    title: 'Calificación automática de leads',
    desc: 'Detecta quién realmente desea alquilar o comprar, captura presupuesto, zona y liquidez, y te entrega solo los leads listos para avanzar.',
  },
  {
    icon: 'ph:house-line',
    title: 'Recomendación de inmuebles',
    desc: 'Cada lead recibe propiedades de tu portafolio que encajan con lo que busca, directo en el chat.',
  },
  {
    icon: 'ph:calendar-check',
    title: 'Agendamiento de visitas',
    desc: 'Coordina la cita en la misma conversación, sin idas y vueltas de mensajes con tu equipo.',
  },
  {
    icon: 'ph:arrows-clockwise',
    title: 'Seguimientos automatizados',
    desc: 'Si un lead deja de responder, Luisa retoma la conversación por ti: recordatorios y seguimientos en el momento justo, hasta agendar la visita o cerrar el ciclo.',
  },
  {
    icon: 'ph:paper-plane-tilt',
    title: 'Outreach a escala',
    desc: 'Reactiva tu base de datos con campañas salientes por WhatsApp: la misma conversación personalizada, para cien o para diez mil contactos.',
  },
];

const team = [
  {
    foto: fotoLucia,
    nombre: 'Lucía',
    rol: 'Mantenimiento IA',
    desc: 'Recibe las solicitudes de mantenimiento de tus inquilinos, coordina proveedores y hace seguimiento automático hasta cerrar cada caso.',
  },
  {
    foto: fotoLaura,
    nombre: 'Laura',
    rol: 'Administrativa IA',
    desc: 'Atiende a inquilinos y propietarios 24/7: resuelve consultas de pagos, certificados y trámites sin intervención humana, con una respuesta personalizada para cada caso.',
  },
  {
    foto: fotoLina,
    nombre: 'Lina',
    rol: 'Cobranza IA',
    desc: 'Gestiona la cobranza y los recordatorios de pago por WhatsApp, con el tono firme y cordial que protege la relación con tu cliente.',
  },
  {
    foto: fotoLorena,
    nombre: 'Lorena',
    rol: 'Jurídica IA',
    desc: 'Resuelve consultas sobre contratos, requisitos y garantías con base en tus propios documentos, y escala a tu abogado solo los casos que lo necesitan.',
  },
  {
    foto: fotoLiliana,
    nombre: 'Liliana',
    rol: 'Escrituración IA',
    desc: 'Acompaña a compradores y vendedores durante la escrituración: documentos pendientes, citas en notaría y estado del trámite, sin que tu equipo responda caso por caso.',
  },
];

---

<Base
  title="Agentes IA para inmobiliarias: Livvo"
  description="Luisa y su equipo de agentes IA atienden el WhatsApp de tu inmobiliaria 24/7: ventas, mantenimiento, administración, cobranza, escrituración y jurídico, con tu tono y bajo tus reglas."
  ogImage="/og/luisa-ia.png"
>
  <Navbar />

  <main>
    <!-- HERO del producto: texto a la izquierda, demo de WhatsApp a la derecha -->
    <header class="product-hero product-hero--luisa">
      <div class="container-site product-hero__inner">
        <div class="product-hero__copy">
          <span class="product-hero__badge">Producto · Agentes IA</span>
          <h1>Agentes IA que <em class="grad-text">venden por ti.</em></h1>
          <p class="product-hero__sub">
            Luisa responde en segundos, califica cada lead, recomienda inmuebles de tu portafolio y
            agenda visitas. Su equipo se encarga del mantenimiento, la administración, la
            cobranza, la escrituración y lo jurídico. Con tu tono y bajo tus reglas, 24/7.
          </p>
          <div class="product-hero__ctas">
            <Button href={WHATSAPP_URL} target="_blank" size="lg" id="empleados-demo-cta">
              Prueba 15 días gratis →
            </Button>
          </div>
        </div>

        <div class="product-hero__demo" aria-label="Conversación de WhatsApp con Luisa">
          <div class="demo__bg" aria-hidden="true">
            <svg class="demo__circles" viewBox="0 0 200 200" fill="none" stroke="currentColor">
              <circle cx="100" cy="100" r="90" stroke-width="0.35" stroke-dasharray="2 3" />
              <circle cx="100" cy="100" r="68" stroke-width="0.35" />
              <circle cx="100" cy="100" r="46" stroke-width="0.4" stroke-dasharray="1 2" />
              <circle cx="100" cy="100" r="24" stroke-width="0.5" stroke="#6C63FF" opacity="0.35" />
            </svg>
          </div>
          <iframe
            src="/livvo-whatsapp.html"
            width="424"
            height="740"
            loading="lazy"
            scrolling="no"
            title="Conversación de WhatsApp con Luisa, la IA de Livvo"
            class="demo__frame"></iframe>
        </div>
      </div>
    </header>

    <!-- AGENTE ESTRELLA: Luisa -->
    <Section alt>
      <div class="star-head fade-up">
        <span class="eyebrow">Nuestra agente estrella</span>
        <h2>Luisa, tu Agente Comercial IA</h2>
        <Image
          src={fotoLuisa}
          alt="Luisa, Agente Comercial IA de Livvo"
          width={280}
          densities={[1, 2]}
          class="star-head__foto"
        />
      </div>
      <div class="pfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="pfeature">
            <span class="pfeature__icon" aria-hidden="true">
              <Icon name={icon} width={22} height={22} />
            </span>
            <h3 class="pfeature__title">{title}</h3>
            <p class="pfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- EL RESTO DEL EQUIPO -->
    <Section eyebrow="El equipo completo" title="Luisa no trabaja sola">
      <div class="team fade-up">
        {team.map(({ foto, nombre, rol, desc }) => (
          <article class="tcard">
            {foto ? (
              <Image
                src={foto}
                alt={`${nombre}, ${rol} de Livvo`}
                width={240}
                densities={[1, 2]}
                class="tcard__foto"
              />
            ) : (
              <span class="tcard__foto tcard__foto--placeholder" aria-hidden="true">
                {nombre.charAt(0)}
              </span>
            )}
            <h3 class="tcard__nombre">{nombre}</h3>
            <span class="tcard__rol">{rol}</span>
            <p class="tcard__desc">{desc}</p>
          </article>
        ))}
      </div>
      <p class="team__note fade-up">
        Cada agente IA se configura contigo antes de salir a producción (tu tono, tu portafolio
        y tus reglas de negocio) y trabaja con el nivel de autonomía que tú decidas: responde solo
        o prepara borradores que tu equipo revisa y aprueba.
      </p>
    </Section>

    <!-- PUENTE A LIVVO CHAT: espejo del puente hacia Luisa en la página de la plataforma -->
    <Section
      alt
      eyebrow="Plataforma de atención al cliente"
      title="Luisa trabaja dentro de Livvo Chat"
    >
      <div class="product-cta fade-up">
        <p>
          Cada conversación que atienden Luisa y su equipo queda registrada en Livvo Chat, la
          bandeja compartida donde trabaja tu equipo humano: embudo, propiedades, campañas y
          reportes en un solo lugar. Tú ves toda la operación; ellas hacen el trabajo operativo.
        </p>
        <Button href="/plataforma-de-atencion-al-cliente" variant="outline" size="lg">
          Conocer Livvo Chat →
        </Button>
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Pruébalo" title="Habla con Luisa ahora mismo">
      <div class="product-cta fade-up">
        <p>
          La mejor forma de evaluar un agente IA es conversar con uno. Escríbele a Luisa por
          WhatsApp y mira cómo atiende, califica y recomienda en una conversación real.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="empleados-cta-final">
          Prueba 15 días gratis →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .product-hero {
    padding: 130px 0 40px;
    overflow: hidden;
  }
  .product-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-10);
  }
  .product-hero__copy {
    text-align: left;
  }
  .product-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(108, 99, 255, 0.4);
    color: var(--violet);
    background: rgba(108, 99, 255, 0.08);
  }
  .product-hero h1 {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 0 0 16px;
  }
  .product-hero h1 em {
    font-style: normal;
  }
  .product-hero__sub {
    color: var(--muted);
    font-size: 17px;
    line-height: var(--lh-body);
    max-width: 560px;
    margin: 0 0 32px;
  }
  .product-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- Demo en el hero: teléfono con anillos concéntricos (patrón del DS) ---- */
  .product-hero__demo {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .demo__frame {
    border: 0;
    max-width: 100%;
    display: block;
    position: relative;
    z-index: 1;
  }
  .demo__bg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(680px, 100vw);
    height: min(680px, 100vw);
    transform: translate(-50%, -50%);
    color: var(--border);
    pointer-events: none;
    z-index: 0;
  }
  /* máscara radial: los anillos se desvanecen hacia los bordes */
  .demo__bg::after {
    content: '';
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at center, transparent 30%, var(--white) 78%);
  }
  .demo__circles {
    width: 100%;
    height: 100%;
    display: block;
    animation: rings-spin 140s linear infinite;
  }
  @keyframes rings-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo__circles { animation: none; }
  }

  /* ---- Cabecera de la agente estrella (replica .section__head + foto) ---- */
  .star-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--space-12);
  }
  .star-head :global(.star-head__foto) {
    display: block;
    width: 220px;
    height: 220px;
    object-fit: cover;
    margin: var(--space-6) auto 0;
    border-radius: 50%;
    border: 4px solid rgba(108, 99, 255, 0.45);
    box-shadow: 0 10px 40px rgba(108, 99, 255, 0.22);
  }
  @media (max-width: 640px) {
    .star-head :global(.star-head__foto) {
      width: 170px;
      height: 170px;
    }
  }
  .star-head h2 {
    margin-top: var(--space-4);
    font-size: clamp(32px, 4vw, 44px);
    letter-spacing: -1px;
  }

  .pfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .pfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: box-shadow var(--transition), border-color var(--transition),
      background-color var(--transition), transform var(--transition);
  }
  .pfeature:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    background: rgba(108, 99, 255, 0.07);
    border-color: rgba(108, 99, 255, 0.45);
  }
  /* chip circular del DS (mismo que el home), en violeta */
  .pfeature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    margin-bottom: var(--space-4);
    background:
      radial-gradient(circle at 50% 130%, rgba(108, 99, 255, 0.26) 0%, transparent 72%),
      linear-gradient(180deg, #ffffff 0%, #f4f6fa 100%);
    border: 1px solid var(--border);
    box-shadow: 0 6px 16px rgba(13, 20, 36, 0.08);
    color: var(--violet);
    transition: box-shadow var(--transition), transform var(--transition);
  }
  .pfeature:hover .pfeature__icon {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(108, 99, 255, 0.24);
  }
  .pfeature__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .pfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  /* ---- Equipo de agentes IA ---- */
  .team {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .tcard {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    text-align: center;
    transition: box-shadow var(--transition), border-color var(--transition),
      transform var(--transition);
  }
  .tcard:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    border-color: rgba(0, 199, 180, 0.45);
  }
  .tcard :global(.tcard__foto) {
    display: block;
    width: 120px;
    height: 120px;
    object-fit: cover;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    border: 3px solid rgba(0, 199, 180, 0.35);
  }
  /* avatar temporal mientras el agente IA no tiene foto */
  .tcard .tcard__foto--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.1);
  }
  .tcard__nombre {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-1);
  }
  .tcard__rol {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.1);
    border-radius: 20px;
    padding: 3px 12px;
    margin-bottom: var(--space-3);
  }
  .tcard__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }
  .team__note {
    max-width: 680px;
    margin: var(--space-8) auto 0;
    text-align: center;
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
  }

  .product-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .product-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .product-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .product-hero__copy {
      text-align: center;
      max-width: 640px;
      margin-inline: auto;
    }
    .product-hero__sub { margin-inline: auto; }
    .product-hero__ctas { justify-content: center; }
    .pfeatures { grid-template-columns: repeat(2, 1fr); }
    .team { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .product-hero { padding: 120px 0 40px; }
    .product-hero h1 { font-size: 34px; }
    .pfeatures { grid-template-columns: 1fr; }
    .team { grid-template-columns: 1fr; }
  }
</style>
