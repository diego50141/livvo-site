---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import FAQ from '../components/FAQ.astro';
import DealFlow from '../components/DealFlow.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';
import fotoLuisa from '../assets/equipo/luisa.png';
import fotoLucia from '../assets/equipo/lucia.png';
import fotoLaura from '../assets/equipo/laura.png';
import fotoLina from '../assets/equipo/lina.jpg';
import fotoLorena from '../assets/equipo/lorena.jpg';
import fotoLiliana from '../assets/equipo/liliana.png';

// Conversación del hero: se reproduce en loop, turno a turno, y cuenta el
// ciclo completo — responde, califica, recomienda, agenda y entrega el lead.
const heroChat = [
  { from: 'client' as const, label: 'Carolina', text: 'Hola, vi el apartamento en Chapinero. ¿Sigue disponible?' },
  { from: 'luisa' as const, text: '¡Hola, Carolina! Sí, sigue disponible. ¿Lo buscas para compra o arriendo?' },
  { from: 'client' as const, label: 'Carolina', text: 'Para compra, con un presupuesto de $450 millones.' },
  { from: 'reasoning' as const, label: 'Luisa calificando' },
  {
    from: 'luisa' as const,
    text: 'Perfecto. Tengo 3 opciones en Chapinero y Chicó dentro de tu presupuesto. ¿Te gustaría verlas este sábado?',
  },
  { from: 'client' as const, label: 'Carolina', text: 'Sí, en la mañana.' },
  {
    from: 'luisa' as const,
    text: 'Listo, agendé tu visita el sábado a las 10:00 a.m. Un asesor te confirma hoy mismo.',
  },
];

// El problema del sector: tres costos concretos de operar con herramientas
// sueltas y trabajo manual. Los números son el gancho; el título la tesis.
const problemStats = [
  {
    num: 4,
    suffix: ' h',
    title: 'Tu asesor pierde hasta 4 horas al día respondiendo manualmente.',
    desc: '¿Cuántas alcobas tiene? ¿Dónde queda? ¿Cuánto vale la cuota inicial? Tu equipo responde las mismas preguntas 50 veces al día en vez de enfocarse en cerrar negocios.',
  },
  {
    num: 3,
    suffix: '/10',
    title: 'Solo 3 de cada 10 citas agendadas se cumplen.',
    desc: 'Sin confirmación automática ni recordatorios, tus asesores pierden tiempo esperando clientes que no llegan.',
  },
  {
    num: 1,
    suffix: '%',
    title: 'Apenas el 1% de tus leads se convierte en negocios.',
    desc: 'Clientes que estaban listos para comprar se enfriaron porque nadie les hizo seguimiento a tiempo.',
  },
];

// Cómo funciona: tres pasos que responden uno a uno a las tres tarjetas de
// la sección "El problema" (leads perdidos → propiedades → seguimiento manual).
const steps = [
  {
    n: '01',
    title: 'Cero leads perdidos',
    desc: 'Conectamos portales inmobiliarios, pauta digital y WhatsApp en una sola plataforma y una sola línea. Todo llega a un flujo unificado.',
  },
  {
    n: '02',
    title: 'Tu portafolio en orden',
    desc: 'Propiedades y clientes centralizados en una sola base, lista para que los agentes recomienden con fotos, descripciones y detalles.',
  },
  {
    n: '03',
    title: 'Seguimiento en piloto automático',
    desc: 'Los agentes califican, resuelven objeciones, recomiendan propiedades, agendan citas y envían recordatorios 24/7. Tus asesores solo reciben leads calificados, listos para cerrar.',
  },
] as const;

// Sección Producto: los dos agentes protagonistas (venta y servicio) y el
// resto del equipo. Fotos compartidas con /agentes-ia.
const featuredAgents = [
  {
    key: 'luisa',
    foto: fotoLuisa,
    nombre: 'Luisa',
    rol: 'Agente de ventas',
    points: [
      'Responde 24/7, en segundos y con el tono de tu marca.',
      'Califica cada lead: presupuesto, zona y liquidez.',
      'Envía propiedades de tu portafolio que encajan con la búsqueda.',
      'Agenda citas en la misma conversación.',
    ],
  },
  {
    key: 'lucia',
    foto: fotoLucia,
    nombre: 'Lucía',
    rol: 'Agente de servicio',
    points: [
      'Se conecta con tu base de propiedades y clientes.',
      'Atiende inquilinos y propietarios 24/7.',
      'Resuelve el 80 % de las consultas sin intervención humana.',
    ],
  },
];

const otherAgents = [
  {
    foto: fotoLaura,
    nombre: 'Laura',
    rol: 'Administrativa IA',
    desc: 'Consultas de pagos, certificados y trámites, resueltas al momento.',
  },
  {
    foto: fotoLina,
    nombre: 'Lina',
    rol: 'Cobranza IA',
    desc: 'Recordatorios de pago y gestión de cartera por WhatsApp, con tono firme y cordial.',
  },
  {
    foto: fotoLorena,
    nombre: 'Lorena',
    rol: 'Jurídica IA',
    desc: 'Contratos, requisitos y garantías con base en tus propios documentos.',
  },
  {
    foto: fotoLiliana,
    nombre: 'Liliana',
    rol: 'Escrituración IA',
    desc: 'Acompaña el trámite completo: documentos, notaría y estado del proceso.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  filter: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  home: '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 8.5V21h14V8.5"/><path d="M9 21v-6h6v6"/>',
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  'calendar-check':
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 15h3M8 18h6"/>',  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15v3M12 10v8M17 6v12"/>',
  coin: '<circle cx="12" cy="12" r="10"/><path d="M12 6v12"/><path d="M15.5 9.5c0-1.1-1.57-2-3.5-2s-3.5.9-3.5 2 1.2 1.6 3.5 2 3.5.9 3.5 2-1.57 2-3.5 2-3.5-.9-3.5-2"/>',
  'file-check':
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  shield:
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.6 1.5A4 4 0 0 0 6 19z"/>',  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 5v14c0 1.66-4.03 3-9 3s-9-1.34-9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>',
};

// Tecnología y seguridad: solo afirmaciones ya validadas en el sitio
// (/presentacion) — API oficial de Meta, datos exportables. No inventar
// certificaciones ni garantías que no tengamos.
const techItems = [
  {
    icon: 'chat',
    title: 'API oficial de WhatsApp Business',
    desc: 'Tu línea opera sobre la Meta Cloud API, no sobre soluciones no oficiales que ponen en riesgo tu número.',
  },
  {
    icon: 'calendar',
    title: 'Google Calendar integrado',
    desc: 'Integración nativa con Google Calendar: coordinación de citas sin salir de Livvo.',
  },
  {
    icon: 'cloud',
    title: 'Infraestructura en la nube',
    desc: 'Infraestructura en la nube con monitoreo 24/7. Tus agentes nunca dejan de trabajar.',
  },
  {
    icon: 'database',
    title: 'Tus datos son tuyos',
    desc: 'Exportables vía API y alojados con seguridad de nivel empresarial.',
  },
  {
    icon: 'file-check',
    title: 'Historial completo de conversaciones',
    desc: 'Cada chat queda registrado y auditable. Nada se pierde, aunque un asesor se vaya.',
  },
  {
    icon: 'shield',
    title: 'Roles y permisos por usuario',
    desc: 'Cada asesor ve lo suyo; tú tienes visibilidad de toda la operación.',
  },
];

// Dos formas de trabajar: servicio administrado (Livvo opera) vs. plataforma
// (el equipo del cliente opera con nuestra tecnología, planes en /planes).
const workModes = [
  {
    key: 'administracion',
    name: 'Livvo Administración',
    tagline: 'Delega en Livvo tus campañas de marketing y adquisición de leads.',
    desc: 'Livvo gestiona tus campañas y adquisición de leads de inicio a fin, sin necesidad de contratar personal adicional. Solo te encargas de atender clientes calificados.',
    points: ['Fee por cierre exitoso: cero riesgo', 'Garantía de reposición'],
    ctaLabel: 'Agendar demo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
  {
    key: 'plataforma',
    name: 'Plataforma',
    tagline: 'Tu equipo comercial opera con nuestra tecnología.',
    desc: 'Acceso a crear tus propias automatizaciones y agentes IA, y a nuestros agentes especializados en inmobiliarias.',
    points: [
      'Gestor de propiedades e inquilinos que alimenta tus agentes IA',
      'Flujos especializados en el sector inmobiliario',
      'KAM dedicado',
      'Integración con tus sistemas actuales',
    ],
    ctaLabel: 'Ver planes →',
    ctaHref: '/planes',
    ctaVariant: 'outline',
  },
];

// Integraciones — logos oficiales en public/integrations/.
// Dos cintas: CRMs (arriba) y portales inmobiliarios (abajo).
const integrationRows = [
  [
    { name: 'HubSpot', cat: 'CRM', src: '/integrations/hubspot.svg' },
    { name: 'GoHighLevel', cat: 'CRM', src: '/integrations/gohighlevel.svg' },
    { name: 'Wasi', cat: 'CRM inmobiliario', src: '/integrations/wasi.svg' },
    { name: 'Domus', cat: 'CRM inmobiliario', src: '/integrations/domus.png' },
  ],
  [
    { name: 'Fincaraíz', cat: 'Portal', src: '/integrations/fincaraiz.png' },
    { name: 'Metrocuadrado', cat: 'Portal', src: '/integrations/metrocuadrado.png' },
    { name: 'Ciencuadras', cat: 'Portal', src: '/integrations/ciencuadras.svg' },
    { name: 'Century 21', cat: 'Red inmobiliaria', src: '/integrations/century21.svg' },
  ],
];

const faqItems = [
  {
    q: '¿Qué hace exactamente Livvo?',
    a: 'Livvo es el sistema comercial de IA para inmobiliarias que integra en una sola plataforma conversaciones, negocios y agentes de inteligencia artificial. El objetivo es eliminar el trabajo operativo de tu equipo y aumentar tu tasa de cierre.',
  },
  {
    q: '¿La IA reemplaza a mis asesores?',
    a: 'No. Imagínalos como una primera línea que nunca duerme: los agentes IA responden, califican y agendan; tus asesores entran cuando hay una visita que atender o un negocio que cerrar, con todo el historial de la conversación a la vista, y pueden intervenir en cualquier momento si lo ven necesario.',
  },
  {
    q: '¿Qué pasa si la IA no sabe responder algo?',
    a: 'Escala la conversación a un asesor humano en el mismo chat, sin que el cliente tenga que repetir nada. Además tú defines el nivel de autonomía: puede responder sola o dejar el borrador listo para que alguien lo apruebe antes de enviarlo.',
  },
  {
    q: '¿Sirve solo para vender, o también para arriendos y postventa?',
    a: 'También. Los mismos agentes IA atienden a inquilinos y propietarios: requisitos, mantenimiento, renovaciones y estado de un proceso, sin que tu equipo tenga que responder caso por caso.',
  },
  {
    q: '¿Funciona con los leads que llegan de los portales?',
    a: 'Sí. Los leads de Fincaraíz, Metrocuadrado, Ciencuadras o tu propia página entran a la misma bandeja y reciben respuesta en segundos, sin importar la hora.',
  },
  {
    q: '¿Puedo seguir usando el número de WhatsApp que ya tiene mi inmobiliaria?',
    a: 'Sí. Migramos tu línea actual a WhatsApp Business API para que tus clientes sigan escribiendo al mismo número, y todo el equipo atiende desde una bandeja compartida en vez de desde celulares sueltos.',
  },
  {
    q: '¿De quién son los contactos y las conversaciones?',
    a: 'De tu inmobiliaria. Contactos, historial y negocios viven en la plataforma, no en el celular del asesor: si alguien se va del equipo, la relación con el cliente se queda.',
  },
  {
    q: '¿Cuánto tiempo toma implementarlo?',
    a: 'Entre 1 y 3 días dependiendo de la personalización. Incluye entrenamiento del agente y conexión con WhatsApp Business API.',
  },
  {
    q: '¿De qué depende el precio?',
    a: 'Del volumen de conversaciones al mes, del número de propiedades que administres y de cuántos usuarios de tu equipo entran a la plataforma.',
  },
  {
    q: '¿Qué pasa si quiero cancelar?',
    a: 'No hay contrato de permanencia — cancelas cuando quieras, sin penalidades. Te acompañamos durante la implementación para asegurarnos de que veas resultados desde el primer mes.',
  },
];

const faqSubtitle = 'Más información sobre Livvo';
---

<Base>
  <Navbar />

  <main>
  <!-- HERO — partículas teal como energía ambiental -->
  <div class="hero-scene">
    <div id="hero-particles" class="hero-scene__particles" aria-hidden="true"></div>
    <header class="hero">
      <div class="container-site hero__inner">
        <div class="hero__content" id="hero-content">
          <span class="hero__badge">
            Automatización para <span class="hero__badge-word" id="hero-badge-word">inmobiliarias</span>
          </span>
          <h1 class="hero__title">
            Agenda más citas. <em class="grad-text">Sin crecer tu equipo.</em>
          </h1>
          <p class="hero__sub">
            Livvo automatiza tu operación comercial y atención al cliente con agentes que
            prospectan, agendan citas, envían propiedades, hacen cobranza y gestionan
            solicitudes de arrendatarios en WhatsApp 24/7. Se integra con tus sistemas actuales.
          </p>
          <div class="hero__ctas">
            <Button href={WHATSAPP_URL} target="_blank" size="lg" id="hero-demo-cta">Prueba 15 días gratis →</Button>
          </div>
        </div>
        <div class="hero__chat">
          <DealFlow />
        </div>
      </div>
    </header>
  </div>

  <!-- EL PROBLEMA — lo que cuesta operar fragmentado y a mano -->
  <Section
    id="problema"
    eyebrow="El problema"
    title="Tu operación comercial está fragmentada."
    subtitle="Marketing, ventas y atención al cliente dependen de herramientas sueltas y trabajo manual que no alcanzan para cumplir las metas."
    alt
  >
    <div class="problem-grid fade-up">
      {problemStats.map(({ num, suffix, title, desc }) => (
        <article class="problem-card">
          <span class="problem-card__value">{num}{suffix}</span>
          <h3 class="problem-card__title">{title}</h3>
          <p class="problem-card__desc">{desc}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- CÓMO FUNCIONA — tres pasos, espejo de las tres tarjetas del problema -->
  <Section
    id="como-funciona"
    eyebrow="Cómo funciona"
    title="Un solo flujo: del lead perdido al negocio cerrado."
    subtitle="Tu nuevo equipo comercial y de atención al cliente trabaja mientras duermes."
  >
    <div class="how-grid fade-up">
      {steps.map(({ n, title, desc }) => (
        <article class="how-card">
          <span class="how-card__num">{n}</span>
          <h3 class="how-card__title">{title}</h3>
          <p class="how-card__desc">{desc}</p>
        </article>
      ))}
    </div>
    <div class="how-cta fade-up">
      <Button href={WHATSAPP_URL} target="_blank" size="lg">Prueba 15 días gratis →</Button>
    </div>
  </Section>

  <!-- PRODUCTO — Luisa y Lucía primero; el resto del equipo debajo -->
  <Section
    id="producto"
    eyebrow="Producto"
    title="Agentes que saben vender y atender clientes de manera personalizada, y se alimentan de tu base de propiedades y clientes."
    subtitle="Atienden, califican, envían propiedades y agendan citas por WhatsApp y web. Tu equipo solo se enfoca en cerrar."
  >
    <div class="agents-featured fade-up">
      {featuredAgents.map(({ key, foto, nombre, rol, points }) => (
        <article class:list={['agent-card', `agent-card--${key}`]}>
          <div class="agent-card__head">
            <Image
              class="agent-card__photo"
              src={foto}
              alt={`${nombre}, ${rol} de Livvo`}
              width={180}
              densities={[1, 2]}
            />
            <div>
              <h3 class="agent-card__name">{nombre}</h3>
              <span class="agent-card__rol">{rol}</span>
            </div>
          </div>
          <ul class="agent-card__points">
            {points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <header class="agents-more fade-up">
      <h3 class="agents-more__title">No solo la venta.</h3>
      <p class="agents-more__sub">
        El resto del equipo cubre toda la operación: administración, cobranza, jurídico y escrituración.
      </p>
    </header>
    <div class="agents-grid fade-up">
      {otherAgents.map(({ foto, nombre, rol, desc }) => (
        <article class="agent-mini">
          <Image
            class="agent-mini__photo"
            src={foto}
            alt={`${nombre}, ${rol} de Livvo`}
            width={88}
            densities={[1, 2]}
          />
          <h4 class="agent-mini__name">{nombre}</h4>
          <span class="agent-mini__rol">{rol}</span>
          <p class="agent-mini__desc">{desc}</p>
        </article>
      ))}
    </div>
    <div class="agents-cta fade-up">
      <a class="agents-cta__link" href="/agentes-ia">Conocer a todo el equipo →</a>
    </div>
  </Section>

  <!-- INTEGRACIONES -->
  <Section
    id="integraciones"
    eyebrow="Integraciones"
    title="Livvo se conecta con los sistemas que ya usas."
    subtitle="Integración con los principales CRMs, portales y ERPs del mercado inmobiliario."
    alt
  >
    <div class="integrations fade-up">
      {integrationRows.map((row, i) => (
        <div class="integrations__marquee">
          <div class:list={['integrations__track', { 'integrations__track--reverse': i % 2 === 1 }]}>
            {[0, 1].map((copy) => (
              <div class="integrations__group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map(({ name, cat, src }) => (
                  <span class="integration-pill" title={`${name} · ${cat}`}>
                    <img class="integration-pill__logo" src={src} alt={name} loading="lazy" />
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="integrations__note">
        ¿Usas otro sistema? <a href={WHATSAPP_URL} target="_blank" rel="noopener">Cuéntanos</a>.
      </p>
    </div>
  </Section>

  <!-- TECNOLOGÍA Y SEGURIDAD — reutiliza las tarjetas de features en teal -->
  <Section
    id="tecnologia"
    eyebrow="Tecnología y seguridad"
    title="Tecnología en la que puedes confiar."
    subtitle="Infraestructura y APIs oficiales para que tu operación nunca se detenga."
  >
    <div class="features-grid fade-up">
      {techItems.map(({ icon, title, desc }) => (
        <article class="feature-card feature-card--admin">
          <span class="feature-card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={featureIcons[icon]}
            />
          </span>
          <h3 class="feature-card__title">{title}</h3>
          <p class="feature-card__desc">{desc}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- DOS FORMAS DE TRABAJAR — administrado vs. plataforma -->
  <Section
    id="planes"
    eyebrow="Planes"
    title="Dos formas de trabajar."
    subtitle="El mismo resultado. Tú decides cuánto control quieres."
    alt
  >
    <div class="work-grid fade-up">
      {workModes.map(({ key, name, tagline, desc, points, ctaLabel, ctaHref, ctaVariant }) => (
        <article class:list={['work-card', `work-card--${key}`]}>
          <h3 class="work-card__name">{name}</h3>
          <p class="work-card__tagline">{tagline}</p>
          <p class="work-card__desc">{desc}</p>
          <ul class="work-card__points">
            {points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          <div class="work-card__cta">
            <Button
              href={ctaHref}
              target={ctaHref.startsWith('http') ? '_blank' : undefined}
              variant={ctaVariant}
              size="lg"
            >
              {ctaLabel}
            </Button>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" eyebrow="FAQ" title="Preguntas frecuentes" subtitle={faqSubtitle}>
    <div class="fade-up">
      <FAQ items={faqItems} />
      <div class="faq-footer fade-up">
        <p>Contáctanos si tienes alguna pregunta o problema.</p>
        <Button href={WHATSAPP_URL} target="_blank" variant="primary">Prueba 15 días gratis →</Button>
      </div>
    </div>
  </Section>
  </main>

  <Footer />
</Base>

<script>
  // Partículas teal del DS: pocas, pequeñas, deriva lenta y parpadeo sutil.
  // Sin top-level await: si algo falla o se cuelga, no bloquea el módulo.
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  const initParticles = async () => {
    await loadSlim(tsParticles);
    await tsParticles.load({
      id: 'hero-particles',
      options: {
        fullScreen: { enable: false },
        background: { color: 'transparent' },
        fpsLimit: 60,
        detectRetina: true,
        particles: {
          number: { value: 18, density: { enable: false } },
          color: { value: '#00C7B4' },
          shape: { type: 'circle' },
          opacity: {
            value: { min: 0.3, max: 0.8 },
            animation: { enable: true, speed: 0.5, sync: false },
          },
          size: { value: { min: 4, max: 7 } },
          shadow: { enable: true, color: '#00C7B4', blur: 18, offset: { x: 0, y: 0 } },
          move: {
            enable: true,
            speed: 0.35,
            direction: 'none',
            random: true,
            straight: false,
            outModes: { default: 'out' },
          },
        },
        interactivity: {
          events: { onHover: { enable: false }, onClick: { enable: false }, resize: { enable: true } },
        },
      },
    });
  };

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    initParticles().catch((e) => console.error('[particles] error:', e));
  }
</script>

<script>
  // Badge del hero: la vertical rota entre los tres segmentos con un
  // crossfade breve; con reduced-motion el texto cambia sin animación.
  const badgeWord = document.getElementById('hero-badge-word');
  const badgeReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const verticals = ['inmobiliarias', 'constructoras', 'desarrolladoras inmobiliarias'];
  let verticalIdx = 0;

  if (badgeWord) {
    setInterval(() => {
      verticalIdx = (verticalIdx + 1) % verticals.length;
      if (badgeReduced) {
        badgeWord.textContent = verticals[verticalIdx];
        return;
      }
      badgeWord.classList.add('is-out');
      setTimeout(() => {
        badgeWord.textContent = verticals[verticalIdx];
        badgeWord.classList.remove('is-out');
      }, 250);
    }, 3000);
  }
</script>

