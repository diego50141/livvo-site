---
// Visual del hero: del empleado IA que creas hasta el negocio en el embudo.
// Cuatro estados encadenados que rotan solos. La lógica es un temporizador
// de ~20 líneas; el resto son transiciones CSS.
const steps = [
  { key: 'agent', label: 'Agente IA' },
  { key: 'chat', label: 'Conversación' },
  { key: 'card', label: 'Contacto' },
  { key: 'deal', label: 'Negocio' },
];

// Instrucciones del agente: las mismas que se escriben en Agentes IA →
// Comportamiento → "Contexto del negocio e instrucciones".
// Cada línea se escribe sola: --c es el nº de caracteres (pasos del steps())
// y --t el momento en que arranca dentro de la escena.
const prompt = [
  { text: 'Eres Luisa, la asistente de nuestra inmobiliaria.', t: 0.2 },
  { text: 'Atiendes leads, resuelves dudas y agendas visitas.', t: 0.75 },
  { text: 'Tono cálido y cercano. Máximo un emoji.', t: 1.3 },
];

// La conversación: el lead pide algo concreto, Luisa responde con un inmueble
// del portafolio, propone horarios y el lead acepta la cita.
const turns = [
  {
    from: 'in',
    text: 'Hola, busco apartamento en arriendo en Bogotá, por Santa Bárbara. Necesito 2 habitaciones, parqueadero y que acepten mascotas. Hasta $2.500.000.',
  },
  {
    from: 'ai',
    text: 'Tengo uno de 68 m² en Santa Bárbara: 2 habitaciones, parqueadero cubierto y admite mascotas pequeñas 🐶 $2.300.000 + $380.000 de administración.',
  },
  { from: 'ai', text: '¿Te sirve verlo este sábado? Tengo 10:00 a. m. u 11:30 a. m.' },
  { from: 'in', text: 'El sábado a las 10 me queda perfecto' },
];
---

<div
  class="deal"
  data-deal
  data-step="0"
  aria-label="Del agente IA que creas al negocio en el embudo"
>
  <span class="deal__glow" aria-hidden="true"></span>

  <div class="deal__stage">
    <!-- 1 · el empleado IA que configuras -->
    <div class="deal__scene deal__scene--agent">
      <div class="flow">
        <header class="flow__head">
          <span class="flow__name">Agentes IA</span>
          <span class="flow__tabs" aria-hidden="true">
            <span class="flow__tab">Playground</span>
            <span class="flow__tab is-on">Configuración</span>
          </span>
        </header>

        <p class="cfg__legend">Comportamiento</p>
        <div class="cfg__prompt">
          {
            prompt.map(({ text, t }) => (
              <span class="cfg__line" style={`--c:${text.length};--t:${t}s`}>
                {text}
              </span>
            ))
          }
          <span class="cfg__caret" aria-hidden="true"></span>
        </div>

        <p class="cfg__legend">Base de conocimiento</p>
        <div class="cfg__upload">
          <span class="cfg__file">portafolio-agosto.csv</span>
          <span class="cfg__bar" aria-hidden="true"><span class="cfg__fill"></span></span>
          <span class="cfg__done">Indexado</span>
        </div>

        <div class="cfg__switch" style="--n:0">
          <span>Habilitar asistente de IA</span>
          <span class="cfg__track" aria-hidden="true">
            <span class="cfg__ripple"></span>
            <span class="cfg__knob"></span>
          </span>
        </div>
        <div class="cfg__switch" style="--n:1">
          <span>Responder automáticamente</span>
          <span class="cfg__track" aria-hidden="true">
            <span class="cfg__ripple"></span>
            <span class="cfg__knob"></span>
          </span>
        </div>

        <!-- el puntero que hace los dos clics -->
        <svg class="cfg__cursor" viewBox="0 0 12 18" aria-hidden="true">
          <path
            d="M1 1l9.5 7.2-4.2.6 2.4 5.1-2 1-2.4-5.1-2.8 3z"
            fill="var(--navy)"
            stroke="var(--white)"
            stroke-width="1"
          />
        </svg>
      </div>
    </div>

    <!-- 2 · la conversación -->
    <div class="deal__scene deal__scene--chat">
      <div class="chat">
        <header class="chat__head">
          <span class="chat__avatar">A</span>
          <div>
            <strong>Andrés Mejía</strong>
            <span class="chat__meta">WhatsApp · ahora</span>
          </div>
        </header>
        {
          turns.map(({ from, text }, i) => (
            <p class:list={['bubble', `bubble--${from}`]} style={`--n:${i}`}>
              {text}
            </p>
          ))
        }
        <span class="chat__by">Luisa · Agente IA</span>
      </div>
    </div>

    <!-- 3 · el contacto ya calificado -->
    <div class="deal__scene deal__scene--card">
      <article class="card">
        <header class="card__head">
          <span class="card__avatar">A</span>
          <div>
            <strong>Andrés Mejía</strong>
            <span class="card__meta">+57 318 774 1903</span>
          </div>
          <span class="card__tag">arrendar</span>
        </header>
        <dl class="card__rows">
          <div><dt>Zona</dt><dd>Santa Bárbara, Bogotá</dd></div>
          <div><dt>Presupuesto</dt><dd>Hasta $2.500.000</dd></div>
          <div><dt>Requisitos</dt><dd>2 hab, parqueadero, mascotas</dd></div>
          <div><dt>Visita</dt><dd>Sábado 10:00 a. m.</dd></div>
        </dl>
      </article>
    </div>

    <!-- 4 · el negocio aterriza en el embudo -->
    <div class="deal__scene deal__scene--deal">
      <div class="funnel">
        {
          ['Lead nuevo', 'Contactado', 'Visita agendada'].map((col, i) => (
            <div class="funnel__col">
              <span class="funnel__title">{col}</span>
              {i === 0 && <span class="funnel__ghost" />}
              {i === 1 && <span class="funnel__ghost" />}
              {i === 1 && <span class="funnel__ghost funnel__ghost--short" />}
              {i === 2 && (
                <span class="funnel__card">
                  <span class="funnel__card-name">Andrés Mejía</span>
                  <span class="funnel__card-meta">Santa Bárbara · $2.3M</span>
                  <span class="funnel__card-tag">arrendar</span>
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- riel de progreso: le pone nombre a lo que está pasando -->
  <ol class="deal__rail">
    {
      steps.map(({ label }, i) => (
        <li class="deal__rail-item" data-rail={i}>
          <span class="deal__dot" />
          {label}
        </li>
      ))
    }
  </ol>
</div>

<script>
  const el = document.querySelector('[data-deal]');
  // cada escena dura según cuánto hay que leer en ella
  const HOLD = [5400, 4200, 2200, 1900];

  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    const next = () => {
      i = (i + 1) % HOLD.length;
      el.dataset.step = String(i);
      setTimeout(next, HOLD[i]);
    };
    setTimeout(next, HOLD[0]);
  }
</script>

<style>
  .deal {
    position: relative;
    width: 100%;
  }
  .deal__glow {
    position: absolute;
    inset: -6% -6% 10% -6%;
    background: radial-gradient(
      ellipse at 50% 40%,
      color-mix(in srgb, var(--teal) 20%, transparent),
      transparent 70%
    );
    filter: blur(30px);
    pointer-events: none;
  }

  /* el escenario fija la altura para que los cuatro estados no salten */
  .deal__stage {
    position: relative;
    /* alto de la escena más alta (el lienzo de Flujos) para que no salten */
    height: 420px;
  }
  .deal__scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  .deal[data-step='0'] .deal__scene--agent,
  .deal[data-step='1'] .deal__scene--chat,
  .deal[data-step='2'] .deal__scene--card,
  .deal[data-step='3'] .deal__scene--deal {
    opacity: 1;
    transform: none;
  }
  /* el estado que ya pasó sale hacia arriba: da sensación de avance */
  .deal[data-step='1'] .deal__scene--agent,
  .deal[data-step='2'] .deal__scene--chat,
  .deal[data-step='3'] .deal__scene--card {
    transform: translateY(-14px) scale(0.97);
  }

  /* ---- superficie común de las cuatro escenas ---- */
  .flow,
  .chat,
  .card,
  .funnel {
    width: 100%;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-md);
  }

  /* ---- 1 · configuración del empleado IA ----
     Replica Agentes IA → Configuración: instrucciones de comportamiento,
     interruptores y base de conocimiento. */
  .flow { position: relative; padding: 14px; }
  .flow__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 10px;
  }
  .flow__name { font-size: 13px; font-weight: 700; }
  .flow__tabs {
    margin-left: auto;
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: 7px;
    background: var(--surface);
  }
  .flow__tab {
    padding: 3px 9px;
    border-radius: 5px;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .flow__tab.is-on { background: var(--white); color: var(--text); }

  .cfg__legend {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--teal-deep);
  }
  .cfg__legend::before {
    content: '';
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: currentColor;
  }
  /* --- el prompt se escribe de verdad, carácter a carácter --- */
  .cfg__prompt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 9px 10px;
    margin-bottom: 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    min-height: 74px;
  }
  .cfg__line {
    font-size: 11.5px;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    max-width: 0;
  }
  .cfg__line:first-child { font-weight: 600; }
  .deal[data-step='0'] .cfg__line {
    animation: type 0.55s steps(var(--c)) var(--t) both;
  }
  @keyframes type {
    to { max-width: 100%; }
  }
  .cfg__caret {
    position: absolute;
    left: 10px;
    bottom: 9px;
    width: 6px;
    height: 13px;
    background: var(--teal);
    opacity: 0;
  }
  .deal[data-step='0'] .cfg__caret {
    animation: caret 0.7s steps(2) 0.2s 3, fade-out 0.2s 2.1s both;
  }
  @keyframes caret {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  /* --- la fuente de información que se carga e indexa --- */
  .cfg__upload {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    margin-bottom: 10px;
    border-radius: 8px;
    border: 1px dashed var(--border);
    font-size: 11px;
    opacity: 0;
  }
  .deal[data-step='0'] .cfg__upload {
    animation: pop-in 0.3s 2s ease both;
  }
  .cfg__file {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }
  .cfg__bar {
    flex: 1;
    height: 5px;
    border-radius: 999px;
    background: var(--surface);
    overflow: hidden;
  }
  .cfg__fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 999px;
    background: var(--teal);
  }
  .deal[data-step='0'] .cfg__fill {
    animation: fill 0.8s 2.3s ease-out both;
  }
  @keyframes fill {
    to { width: 100%; }
  }
  .cfg__done {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    color: var(--teal-deep);
    opacity: 0;
  }
  .cfg__done::before { content: '✓'; }
  .deal[data-step='0'] .cfg__done {
    animation: pop-in 0.3s 3.1s ease both;
  }
  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: none; }
  }

  /* --- los dos interruptores, encendidos por el puntero --- */
  .cfg__switch {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
    font-size: 11.5px;
  }
  .cfg__switch span:first-child { flex: 1; }
  .cfg__track {
    position: relative;
    flex: none;
    width: 34px;
    height: 18px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .cfg__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--muted);
  }
  .deal[data-step='0'] .cfg__knob {
    animation: knob-on 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.4) both;
    animation-delay: calc(3.9s + var(--n) * 0.6s);
  }
  @keyframes knob-on {
    from { transform: none; background: var(--muted); }
    to { transform: translateX(16px); background: var(--teal); }
  }
  /* onda del clic */
  .cfg__ripple {
    position: absolute;
    inset: -6px;
    border-radius: 999px;
    border: 2px solid var(--teal);
    opacity: 0;
  }
  .deal[data-step='0'] .cfg__ripple {
    animation: ripple 0.5s ease-out both;
    animation-delay: calc(3.9s + var(--n) * 0.6s);
  }
  @keyframes ripple {
    from { opacity: 0.8; transform: scale(0.6); }
    to { opacity: 0; transform: scale(1.5); }
  }

  /* --- el puntero --- */
  .cfg__cursor {
    position: absolute;
    right: 22px;
    bottom: 74px;
    width: 13px;
    height: 19px;
    opacity: 0;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.25));
  }
  .deal[data-step='0'] .cfg__cursor {
    animation: cursor-go 1.8s 3.3s ease-in-out both;
  }
  @keyframes cursor-go {
    0% { opacity: 0; transform: translate(26px, 34px); }
    18% { opacity: 1; transform: translate(4px, 22px); }
    /* clic en el primer interruptor */
    30%, 40% { opacity: 1; transform: translate(0, 22px); }
    38% { transform: translate(0, 24px); }
    /* baja al segundo */
    62%, 74% { opacity: 1; transform: translate(0, 54px); }
    72% { transform: translate(0, 56px); }
    100% { opacity: 0; transform: translate(10px, 62px); }
  }

  /* ---- 2 · chat ---- */
  .chat { padding: 16px; }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 14px;
  }
  .chat__head strong,
  .card__head strong { display: block; font-size: 14px; }
  .chat__avatar,
  .card__avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }
  .chat__meta,
  .card__meta { font-size: 11.5px; color: var(--muted); }
  .bubble {
    margin: 0 0 8px;
    padding: 9px 11px;
    border-radius: 12px;
    font-size: 12.5px;
    line-height: 1.45;
    max-width: 90%;
  }
  .bubble--in {
    background: var(--surface);
    border-top-left-radius: 4px;
  }
  .bubble--ai {
    margin-left: auto;
    background: color-mix(in srgb, var(--teal) 16%, var(--white));
    border: 1px solid color-mix(in srgb, var(--teal) 30%, transparent);
    border-top-right-radius: 4px;
  }
  /* los turnos entran uno tras otro, como en un chat real */
  .deal[data-step='1'] .bubble {
    animation: row-in 0.4s ease both;
    animation-delay: calc(0.2s + var(--n) * 0.5s);
  }
  .chat__by {
    display: block;
    text-align: right;
    font-size: 11px;
    color: var(--teal-deep);
    font-weight: 600;
  }

  /* ---- 3 · ficha de contacto ---- */
  .card { padding: 16px; }
  .card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .card__tag,
  .funnel__card-tag {
    margin-left: auto;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blue) 14%, transparent);
    color: var(--blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
  }
  /* la etiqueta cae sobre la ficha cuando entra la escena */
  .deal[data-step='2'] .card__tag {
    animation: tag-drop 0.45s 0.25s ease both;
  }
  @keyframes tag-drop {
    from { opacity: 0; transform: translateY(-10px) scale(0.9); }
  }

  .card__rows { margin: 0; padding-top: 4px; }
  .card__rows > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .card__rows > div:last-child { border-bottom: 0; }
  .card__rows dt { color: var(--muted); margin: 0; }
  .card__rows dd { margin: 0; font-weight: 600; }
  /* los datos capturados aparecen uno a uno */
  .deal[data-step='2'] .card__rows > div { animation: row-in 0.4s ease both; }
  .deal[data-step='2'] .card__rows > div:nth-child(1) { animation-delay: 0.3s; }
  .deal[data-step='2'] .card__rows > div:nth-child(2) { animation-delay: 0.42s; }
  .deal[data-step='2'] .card__rows > div:nth-child(3) { animation-delay: 0.54s; }
  .deal[data-step='2'] .card__rows > div:nth-child(4) { animation-delay: 0.66s; }

  @keyframes row-in {
    from { opacity: 0; transform: translateX(-8px); }
  }

  /* ---- 4 · embudo ---- */
  .funnel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 14px;
  }
  .funnel__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 8px;
    border-radius: 10px;
    background: var(--gray-bg);
    min-height: 190px;
  }
  .funnel__title {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--muted);
  }
  .funnel__ghost {
    height: 42px;
    border-radius: 8px;
    background: var(--surface);
    opacity: 0.7;
  }
  .funnel__ghost--short { height: 30px; }
  .funnel__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    padding: 10px;
    border-radius: 8px;
    background: var(--white);
    border: 1px solid color-mix(in srgb, var(--teal) 45%, transparent);
    box-shadow: var(--shadow-glow);
  }
  .funnel__card-name { font-size: 12.5px; font-weight: 700; }
  .funnel__card-meta { font-size: 11px; color: var(--muted); }
  .funnel__card-tag { margin-left: 0; }
  /* la tarjeta "aterriza" en la columna final */
  .deal[data-step='3'] .funnel__card {
    animation: card-land 0.55s 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.4) both;
  }
  @keyframes card-land {
    from { opacity: 0; transform: translate(-60px, -90px) scale(1.15); }
  }

  /* ---- riel ---- */
  .deal__rail {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .deal__rail-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    opacity: 0.5;
    transition: opacity var(--transition), color var(--transition);
  }
  .deal__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .deal[data-step='0'] [data-rail='0'],
  .deal[data-step='1'] [data-rail='1'],
  .deal[data-step='2'] [data-rail='2'],
  .deal[data-step='3'] [data-rail='3'] {
    opacity: 1;
    color: var(--teal-deep);
  }

  @media (max-width: 900px) {
    .deal__stage { height: 420px; }
    .deal__rail-item { font-size: 10.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deal__scene { transition: none; }
  }
</style>
