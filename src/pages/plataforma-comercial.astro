---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';

const features = [
  {
    icon: 'chat',
    title: 'Bandeja de equipo para WhatsApp',
    desc: 'Todo tu equipo atiende el WhatsApp de la inmobiliaria desde un solo lugar, con asignación de conversaciones y visibilidad de cada chat.',
  },
  {
    icon: 'users',
    title: 'Contactos y negocios',
    desc: 'Cada lead queda registrado desde el primer mensaje, con su historial completo y los datos que tus Empleados IA capturan en la conversación.',
  },
  {
    icon: 'calendar-check',
    title: 'Calendario de citas del equipo',
    desc: 'Todas las visitas que agendan tus Empleados IA quedan organizadas en el calendario de tus asesores.',
  },
  {
    icon: 'send',
    title: 'Campañas de WhatsApp',
    desc: 'Envía difusiones con plantillas aprobadas por Meta a tus contactos y audiencias, sin salir de la plataforma.',
  },
  {
    icon: 'link',
    title: 'Integración con CRM y ERP',
    desc: 'Conectada con los principales sistemas del mercado inmobiliario. Todo en un solo lugar.',
  },
  {
    icon: 'chart',
    title: 'Informes y métricas',
    desc: 'Rendimiento en tiempo real: conversaciones, atención al cliente, tasas de conversión y productividad.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'calendar-check':
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 15h3M8 18h6"/>',
  send: '<path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15v3M12 10v8M17 6v12"/>',
};
---

<Base
  title="Plataforma Comercial — Livvo"
  description="Bandeja compartida de WhatsApp, calendario, campañas, integraciones y métricas: la plataforma donde tu equipo convierte los leads que tus Empleados IA entregan listos."
>
  <Navbar />

  <main>
    <!-- HERO del producto -->
    <header class="product-hero">
      <div class="container-site product-hero__inner">
        <span class="product-hero__badge">Producto · Plataforma Comercial</span>
        <h1>Donde tu equipo <em class="grad-text">cierra.</em></h1>
        <p class="product-hero__sub">
          La operación comercial de tu inmobiliaria en un solo lugar: la bandeja donde tu equipo
          y tus Empleados IA atienden WhatsApp, el calendario de visitas, las campañas y las
          métricas de todo lo que pasa.
        </p>
        <div class="product-hero__ctas">
          <Button href={WHATSAPP_URL} target="_blank" size="lg" id="plataforma-demo-cta">
            Conversar con Livvo →
          </Button>
          <Button href="/empleados-ia" variant="ghost" size="lg">
            Ver los Empleados IA
          </Button>
        </div>
      </div>
    </header>

    <!-- QUÉ INCLUYE -->
    <Section
      eyebrow="Qué incluye"
      title="Todo lo que tu operación necesita para convertir"
      subtitle="Los leads llegan calificados por tus Empleados IA; la plataforma le da a tu equipo el contexto y las herramientas para cerrarlos."
      alt
    >
      <div class="pfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="pfeature">
            <span class="pfeature__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={featureIcons[icon]}
              />
            </span>
            <h3 class="pfeature__title">{title}</h3>
            <p class="pfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Empieza" title="Conoce la plataforma con tu propia operación">
      <div class="product-cta fade-up">
        <p>
          Cuéntanos cómo trabaja tu inmobiliaria y te mostramos la plataforma configurada con tu
          embudo, tus etapas y tus Empleados IA.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="plataforma-cta-final">
          Conversar con Livvo →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .product-hero {
    padding: 140px 0 80px;
  }
  .product-hero__inner {
    max-width: 800px;
    text-align: center;
    margin-inline: auto;
  }
  .product-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 199, 180, 0.4);
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.08);
  }
  .product-hero h1 {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--navy);
    margin: 0 0 16px;
  }
  .product-hero h1 em {
    font-style: normal;
  }
  .product-hero__sub {
    color: var(--muted);
    font-size: 17px;
    line-height: var(--lh-body);
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .product-hero__ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .pfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .pfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: box-shadow var(--transition), border-color var(--transition),
      background-color var(--transition), transform var(--transition);
  }
  .pfeature:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    background: rgba(0, 199, 180, 0.07);
    border-color: rgba(0, 199, 180, 0.45);
  }
  .pfeature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    margin-bottom: var(--space-4);
    background: rgba(0, 199, 180, 0.1);
    color: var(--teal-deep);
    transition: background-color var(--transition), color var(--transition);
  }
  .pfeature:hover .pfeature__icon {
    background: var(--grad-cta);
    color: #fff;
  }
  .pfeature__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .pfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  .product-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .product-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .pfeatures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .product-hero { padding: 120px 0 60px; }
    .product-hero h1 { font-size: 34px; }
    .pfeatures { grid-template-columns: 1fr; }
  }
</style>
