---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const DEMO_URL = 'https://meetings.hubspot.com/daar5014';
const WHATSAPP_URL =
  'https://wa.me/573159281379?text=' + encodeURIComponent('Hola, quiero conocer Livvo');

// Pantallas fijas que rotan con el scroll (patrón useplaza): la sección mide
// varias alturas de viewport y el contenido queda "pegado" mientras los
// pasos 01 → 02 → 03 se cruzan con fade + desplazamiento.
const steps = [
  {
    n: '01',
    title: 'Luisa responde preguntas',
    desc: 'Luisa responde preguntas en 15 segundos, recopila datos y califica automáticamente los clientes potenciales, directamente en WhatsApp, en cualquier momento.',
    ctaLabel: 'Conversar con Livvo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
  {
    n: '02',
    title: 'Servicio inteligente',
    desc: 'Luisa recomienda propiedades según el perfil del cliente potencial y analiza su solvencia, incluso antes de la visita. Servicio rápido y eficaz, listo para cerrar el trato.',
    ctaLabel: 'Conversar con Livvo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
  {
    n: '03',
    title: 'Clientes potenciales listos para cerrar',
    desc: 'Atiende y resuelve: el 90 % de las solicitudes de servicio se resuelven sin intervención humana, ya sea con inquilinos o propietarios. Luisa continúa brindando soporte después de la firma del contrato sin depender de tu equipo.',
    ctaLabel: 'Conversar con Livvo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
] as const;

// Dos tipos de funcionalidades (patrón useplaza): el servicio de atención
// al cliente que presta Luisa, y las herramientas de administración.
const featureTypes = {
  luisa: 'Luisa · Atención al cliente',
  admin: 'Luisa · Admin',
} as const;

const features = [
  {
    type: 'luisa',
    icon: 'chat',
    title: 'Atención al cliente 24/7 con IA',
    desc: 'Luisa responde en segundos, con el tono de tu inmobiliaria a inquilinos y propietarios en cualquier momento.',
  },
  {
    type: 'luisa',
    icon: 'target',
    title: 'Priorización de clientes potenciales',
    desc: 'Antes de derivar la solicitud a un agente inmobiliario, identifica quién realmente desea alquilar o comprar.',
  },
  {
    type: 'luisa',
    icon: 'filter',
    title: 'Calificación automática de leads',
    desc: 'Luisa detecta presupuesto, zona de interés y liquidez y te entrega solo los leads listos para avanzar.',
  },
  {
    type: 'luisa',
    icon: 'home',
    title: 'Recomendación de inmuebles',
    desc: 'Cada lead recibe propiedades de tu portafolio que encajan con lo que busca, directo en el chat.',
  },
  {
    type: 'luisa',
    icon: 'calendar',
    title: 'Agendamiento de visitas',
    desc: 'Luisa coordina la cita en la misma conversación, sin idas y vueltas de mensajes con tu equipo.',
  },
  {
    type: 'admin',
    icon: 'link',
    title: 'Integración con CRM y ERP',
    desc: 'Luisa ya está integrada con los principales sistemas del mercado inmobiliario. Todo conectado, en un solo lugar.',
  },
  {
    type: 'admin',
    icon: 'calendar-check',
    title: 'Calendario de citas del equipo',
    desc: 'Todas las visitas que agenda Luisa quedan organizadas en el calendario de tus asesores.',
  },
  {
    type: 'luisa',
    icon: 'chart',
    title: 'Informes y métricas',
    desc: 'Realiza un seguimiento del rendimiento en tiempo real con datos sobre conversaciones, atención al cliente, tasas de conversión y productividad.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  filter: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  home: '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 8.5V21h14V8.5"/><path d="M9 21v-6h6v6"/>',
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  'calendar-check':
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 15h3M8 18h6"/>',  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15v3M12 10v8M17 6v12"/>',
};

const plans = [
  {
    name: 'Gratis',
    price: '$0',
    tagline: 'Empieza gratis y prueba la IA sin riesgo',
    features: [
      'Hasta 10 propiedades publicadas',
      'Descripciones con IA',
      'CRM (leads + propietarios)',
      'Calendario de citas',
      'Analíticas y reportes',
    ],
    featured: false,
    ctaLabel: 'Empezar gratis',
  },
  {
    name: 'Básico',
    price: '$200.000',
    tagline: 'Para arrancar con ventas automáticas en WhatsApp',
    features: [
      'Hasta 25 propiedades',
      '500 conversaciones/mes',
      'CRM (leads + propietarios)',
      'Calendario de citas',
      'Analíticas y reportes',
      'Todo lo del plan Gratis',
    ],
    featured: true,
    ctaLabel: 'Conversar con Livvo →',
  },
  {
    name: 'Pro',
    price: '$507.000',
    tagline: 'Para escalar tu operación comercial',
    features: [
      'Hasta 50 propiedades',
      '1.500 conversaciones/mes',
      'CRM (leads + propietarios)',
      'Calendario de citas',
      'Analíticas y reportes',
      'Todo lo del plan Básico',
    ],
    featured: false,
    ctaLabel: 'Conversar con Livvo →',
  },
];

// Integraciones — CONFIRMAR la lista real antes de publicar.
// Dos cintas: herramientas generales (arriba) y sistemas del sector
// inmobiliario (abajo). `mark` es el monograma del pill y `color` un
// aproximado del color de marca (solo tiñe el monograma).
const integrationRows = [
  [
    { name: 'WhatsApp Business API', cat: 'Canal oficial', mark: 'W', color: '#25D366' },
    { name: 'HubSpot', cat: 'CRM', mark: 'H', color: '#FF7A59' },
    { name: 'Salesforce', cat: 'CRM', mark: 'S', color: '#00A1E0' },
    { name: 'Zoho CRM', cat: 'CRM', mark: 'Z', color: '#E42527' },
    { name: 'Pipedrive', cat: 'CRM', mark: 'P', color: '#017737' },
    { name: 'Google Calendar', cat: 'Agenda', mark: 'G', color: '#4285F4' },
  ],
  [
    { name: 'Wasi', cat: 'CRM inmobiliario', mark: 'W', color: '#00B398' },
    { name: 'Simi', cat: 'ERP inmobiliario', mark: 'S', color: '#2E5BFF' },
    { name: 'Fincaraíz', cat: 'Portal', mark: 'F', color: '#6BBE45' },
    { name: 'Metrocuadrado', cat: 'Portal', mark: 'm²', color: '#F5A800' },
    { name: 'Ciencuadras', cat: 'Portal', mark: 'C', color: '#0B5ED7' },
  ],
];

const faqItems = [
  {
    q: '¿Qué hace exactamente Livvo?',
    a: 'Livvo es un agente de IA que conversa con tus leads por WhatsApp, los califica según presupuesto, zona y capacidad de pago, y les recomienda inmuebles personalizados. El objetivo es eliminar el trabajo operativo de tu equipo y aumentar tu tasa de cierre.',
  },
  {
    q: '¿Se necesita un CRM previo?',
    a: 'No. Livvo incluye un portal donde puedes hacer seguimiento a tus leads y monitorear tus métricas comerciales. Si ya tienes un CRM, también nos integramos con él.',
  },
  {
    q: '¿Cuánto tiempo toma implementarlo?',
    a: 'Entre 1 y 3 días dependiendo de la personalización. Incluye entrenamiento del agente y conexión con WhatsApp Business API.',
  },
  {
    q: '¿Y si el bot suena robótico y espanta a mis clientes?',
    a: 'Livvo usa IA conversacional que se adapta al tono de tu inmobiliaria. Entrenamos el agente con el lenguaje real de tu equipo y del sector. Si en la demo no te convence cómo suena, no pagas nada.',
  },
  {
    q: '¿Qué pasa si quiero cancelar?',
    a: 'No hay contrato de permanencia — cancelas cuando quieras, sin penalidades. Te acompañamos durante la implementación para asegurarnos de que veas resultados desde el primer mes.',
  },
];

const faqSubtitle = 'Más información sobre Maya';
---

<Base>
  <Navbar />

  <!-- ESCENA HERO + CONVERSACIÓN — anillos concéntricos como escenario común -->
  <div class="hero-scene">
    <div id="hero-particles" class="hero-scene__particles" aria-hidden="true"></div>
    <header class="hero">
      <div class="container-site hero__inner">
        <div class="hero__content" id="hero-content">
          <h1 class="hero__title">
            Automatiza tu proceso comercial y <em class="grad-text">vende más.</em>
          </h1>
          <p class="hero__sub">
            Descubre cómo Luisa, la inteligencia artificial de Livvo, precalifica y agenda leads
            24/7 aumentando citas y disminuyendo trabajo manual.
          </p>
          <div class="hero__ctas">
            <Button href={WHATSAPP_URL} target="_blank" size="lg" id="hero-demo-cta">Conversar con Livvo →</Button>
          </div>
        </div>
      </div>
    </header>

    <section class="hero-chat">
      <div class="hero-chat__bg" id="chat-rings" aria-hidden="true">
        <svg class="hero-chat__circles" viewBox="0 0 200 200" fill="none" stroke="currentColor">
          <circle cx="100" cy="100" r="90" stroke-width="0.35" stroke-dasharray="2 3" />
          <circle cx="100" cy="100" r="68" stroke-width="0.35" />
          <circle cx="100" cy="100" r="46" stroke-width="0.4" stroke-dasharray="1 2" />
          <circle cx="100" cy="100" r="24" stroke-width="0.5" stroke="#00C7B4" opacity="0.35" />
        </svg>
      </div>
      <div class="container-site hero-chat__inner">
        <div class="hero-chat__stage" id="chat-stage">
          <iframe
            src="/livvo-whatsapp.html"
            width="424"
            height="740"
            loading="lazy"
            scrolling="no"
            title="Conversación de WhatsApp con Luisa, la IA de Livvo"
            class="hero-chat__frame"></iframe>
        </div>
      </div>
    </section>
  </div>

  <!-- CÓMO FUNCIONA — pantallas fijas que pasan con el scroll (estilo useplaza) -->
  <section id="como-funciona" class="steps" aria-label="Cómo funciona Luisa">
    <div class="steps__sticky">
      <div class="container-site steps__inner">
        <div class="steps__nav" aria-hidden="true">
          {steps.map(({ n }, i) => (
            <span class:list={['steps__nav-item', { 'is-active': i === 0 }]} data-step-dot>
              {n}
            </span>
          ))}
        </div>
        <div class="steps__panels">
          {steps.map(({ n, title, desc, ctaLabel, ctaHref, ctaVariant }, i) => (
            <article class:list={['step-panel', { 'is-active': i === 0 }]} data-step-panel>
              <span class="step-panel__num">{n}</span>
              <h2 class="step-panel__title">{title}</h2>
              <p class="step-panel__desc">{desc}</p>
              <div>
                <Button
                  href={ctaHref}
                  variant={ctaVariant}
                  size="lg"
                  target={ctaHref.startsWith('http') ? '_blank' : undefined}
                >
                  {ctaLabel}
                </Button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FUNCIONALIDADES -->
  <Section
    id="funcionalidades"
    eyebrow="Funcionalidades"
    title="La inteligencia artificial más completa del mercado inmobiliario"
  >
    <div class="features-grid fade-up">
      {
        features.map(({ type, icon, title, desc }) => (
          <article class:list={['feature-card', `feature-card--${type}`]}>
            <span class="feature-card__badge">{featureTypes[type as keyof typeof featureTypes]}</span>
            <span class="feature-card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={featureIcons[icon]}
              />
            </span>
            <h3 class="feature-card__title">{title}</h3>
            <p class="feature-card__desc">{desc}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- INTEGRACIONES -->
  <Section
    id="integraciones"
    eyebrow="Integraciones"
    title="Luisa está conectada con los sistemas que ya usas."
    subtitle="Integración con los principales CRMs, portales y ERPs del mercado inmobiliario."
    alt
  >
    <div class="integrations fade-up">
      {integrationRows.map((row, i) => (
        <div class="integrations__marquee">
          <div class:list={['integrations__track', { 'integrations__track--reverse': i % 2 === 1 }]}>
            {[0, 1].map((copy) => (
              <div class="integrations__group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map(({ name, cat, mark, color }) => (
                  <span class="integration-pill" style={`--brand: ${color}`}>
                    <span class="integration-pill__mark" aria-hidden="true">{mark}</span>
                    <span class="integration-pill__body">
                      <span class="integration-pill__name">{name}</span>
                      <span class="integration-pill__cat">{cat}</span>
                    </span>
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="integrations__note">
        ¿Usas otro sistema? <a href={WHATSAPP_URL} target="_blank" rel="noopener">Cuéntanos</a> —
        Luisa se conecta vía API con el stack que ya tienes.
      </p>
    </div>
  </Section>

  <!-- PRECIOS -->
  <Section id="precios" eyebrow="Planes" title="Empieza gratis. Escala cuando quieras.">
    <div class="pricing-grid fade-up">
      {
        plans.map((plan) => (
          <PricingCard
            name={plan.name}
            price={plan.price}
            tagline={plan.tagline}
            features={plan.features}
            featured={plan.featured}
            ctaLabel={plan.ctaLabel}
            ctaHref={WHATSAPP_URL}
            ctaTarget="_blank"
          />
        ))
      }
    </div>
    <div class="pricing-terms fade-up">
      <span>Prueba gratuita de 7 días</span>
      <span>Sin tarjeta de crédito</span>
      <span>Facturación en pesos colombianos</span>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" eyebrow="FAQ" title="Preguntas frecuentes" subtitle={faqSubtitle} alt>
    <div class="fade-up">
      <FAQ items={faqItems} />
      <div class="faq-footer fade-up">
        <p>Contáctanos si tienes alguna pregunta o problema.</p>
        <Button href={WHATSAPP_URL} target="_blank" variant="primary">Conversar con Livvo →</Button>
      </div>
    </div>
  </Section>

  <Footer />
</Base>

<script>
  // Partículas teal del DS: pocas, pequeñas, deriva lenta y parpadeo sutil.
  // Sin top-level await: si algo falla o se cuelga, no bloquea el módulo.
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  const initParticles = async () => {
    await loadSlim(tsParticles);
    await tsParticles.load({
      id: 'hero-particles',
      options: {
        fullScreen: { enable: false },
        background: { color: 'transparent' },
        fpsLimit: 60,
        detectRetina: true,
        particles: {
          number: { value: 18, density: { enable: false } },
          color: { value: '#00C7B4' },
          shape: { type: 'circle' },
          opacity: {
            value: { min: 0.3, max: 0.8 },
            animation: { enable: true, speed: 0.5, sync: false },
          },
          size: { value: { min: 4, max: 7 } },
          shadow: { enable: true, color: '#00C7B4', blur: 18, offset: { x: 0, y: 0 } },
          move: {
            enable: true,
            speed: 0.35,
            direction: 'none',
            random: true,
            straight: false,
            outModes: { default: 'out' },
          },
        },
        interactivity: {
          events: { onHover: { enable: false }, onClick: { enable: false }, resize: { enable: true } },
        },
      },
    });
  };

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    initParticles().catch((e) => console.error('[particles] error:', e));
  }
</script>

<script>
  // Sección "cómo funciona": el contenedor mide 300vh y el contenido queda
  // sticky; el progreso de scroll decide qué paso está activo y los paneles
  // se cruzan con fade + desplazamiento (transiciones CSS → fluido).
  const stepsSection = document.getElementById('como-funciona');
  const stepPanels = Array.from(document.querySelectorAll('[data-step-panel]'));
  const stepDots = Array.from(document.querySelectorAll('[data-step-dot]'));
  const stepsReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stepsSection && stepPanels.length && stepsReduced) {
    // sin animación: pasos apilados, todos visibles
    stepsSection.classList.add('steps--static');
  } else if (stepsSection && stepPanels.length) {
    let stepsTicking = false;

    const updateSteps = () => {
      stepsTicking = false;
      const rect = stepsSection.getBoundingClientRect();
      const scrollable = rect.height - innerHeight;
      if (scrollable <= 0) return;
      const progress = Math.min(1, Math.max(0, -rect.top / scrollable));
      // reparte el progreso en tramos iguales por paso
      const idx = Math.min(stepPanels.length - 1, Math.floor(progress * stepPanels.length));

      stepPanels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === idx);
        panel.classList.toggle('is-past', i < idx);
      });
      stepDots.forEach((dot, i) => dot.classList.toggle('is-active', i === idx));
    };

    addEventListener(
      'scroll',
      () => {
        if (!stepsTicking) {
          stepsTicking = true;
          requestAnimationFrame(updateSteps);
        }
      },
      { passive: true }
    );
    updateSteps();
  }
</script>

<script>
  // Escena hero → teléfono ligada al scroll (estilo useplaza):
  // el teléfono asoma en la primera pantalla y sube/escala mientras
  // el texto del hero se desvanece. Sin librerías: scroll + rAF.
  const stage = document.getElementById('chat-stage');
  const heroContent = document.getElementById('hero-content');
  const rings = document.getElementById('chat-rings');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && heroContent && !reducedMotion) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const progress = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.55)));
      const eased = 1 - Math.pow(1 - progress, 2); // ease-out

      stage.style.transform = `translateY(${(1 - eased) * 90}px) scale(${0.9 + eased * 0.1})`;
      stage.style.opacity = String(0.5 + eased * 0.5);

      heroContent.style.opacity = String(1 - eased * 0.9);
      heroContent.style.transform = `translateY(${-eased * 40}px)`;

      // los anillos ganan presencia y se expanden levemente con el scroll
      if (rings) {
        rings.style.opacity = String(0.4 + eased * 0.6);
        rings.style.transform = `translate(-50%, -50%) scale(${0.92 + eased * 0.08})`;
      }
    };

    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    // al terminar la entrada, soltar la animación CSS para que los estilos
    // inline del scroll tomen el control (una animación activa los pisa)
    heroContent.addEventListener(
      'animationend',
      () => {
        heroContent.style.animation = 'none';
        update();
      },
      { once: true }
    );
    update();
  }
</script>

<style>
  /* La escena contiene hero + chat y aporta el fondo; los anillos
     pueden desbordar entre secciones sin salirse de la escena */
  .hero-scene {
    position: relative;
    overflow: hidden;
    background: var(--white);
    transition: background-color var(--transition);
  }

  /* Partículas teal (patrón del DS: dispersas, energía ambiental) */
  .hero-scene__particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero {
    /* deja ~30vh libres al fondo de la primera pantalla para que el teléfono asome */
    min-height: calc(70vh - 68px);
    display: flex;
    align-items: flex-start;
    background: transparent;
    position: relative;
    z-index: 2;
    padding: 14vh 0 0;
  }
  .hero__inner { width: 100%; }
  .hero__content {
    text-align: center;
    max-width: 880px;
    margin: 0 auto;
    animation: hero-in 0.7s ease both;
    will-change: transform, opacity;
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  .hero__title {
    font-size: clamp(38px, 5vw, 68px);
    letter-spacing: -1.5px;
    line-height: 1.1;
    margin: 0 0 var(--space-6);
  }
  .hero__title em { font-style: normal; }
  .hero__sub {
    font-size: var(--text-body);
    line-height: var(--lh-relaxed);
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto var(--space-8);
  }
  .hero__ctas { display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap; }

  .hero-chat { padding: 24px 0 96px; background: transparent; position: relative; }
  .hero-chat__inner { display: flex; justify-content: center; position: relative; z-index: 1; }
  .hero-chat__stage {
    transform-origin: top center;
    will-change: transform, opacity;
  }
  .hero-chat__frame { border: 0; max-width: 100%; display: block; }

  /* Anillos concéntricos (patrón del DS) centrados donde aterriza el teléfono */
  .hero-chat__bg {
    position: absolute;
    left: 50%;
    top: 44%;
    width: min(1100px, 170vw);
    height: min(1100px, 170vw);
    transform: translate(-50%, -50%);
    color: var(--border);
    pointer-events: none;
    z-index: 0;
    will-change: transform, opacity;
