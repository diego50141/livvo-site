---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import shotBandeja from '../assets/screenshots/bandeja.jpg';
import shotEmbudo from '../assets/screenshots/embudo.jpg';
import shotPanel from '../assets/screenshots/panel.jpg';
import { WHATSAPP_URL, CRM_LOGIN_URL } from '../config';

// Sección de precios oculta por ahora; volver a true para mostrarla
// (también restaura el link "Precios" en Navbar.astro y el alt del FAQ).
const SHOW_PRICING = false;

// Pantallas fijas que rotan con el scroll (patrón useplaza): la sección mide
// varias alturas de viewport y el contenido queda "pegado" mientras los
// pasos 01 → 02 → 03 se cruzan con fade + desplazamiento.
const steps = [
  {
    n: '01',
    title: 'Luisa responde al instante',
    desc: 'Luisa atiende cada mensaje de WhatsApp en segundos, a cualquier hora, con el tono de tu inmobiliaria: responde preguntas, recopila datos del interesado y nunca deja un lead en visto.',
    ctaLabel: 'Conversar con Livvo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
  {
    n: '02',
    title: 'Califica y recomienda',
    desc: 'En la misma conversación detecta si el cliente quiere comprar, arrendar o vender, captura presupuesto, zona y tipo de propiedad, y le recomienda inmuebles de tu portafolio que encajan con su perfil.',
    ctaLabel: 'Conversar con Livvo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
  {
    n: '03',
    title: 'Tu equipo recibe leads listos',
    desc: 'Cada lead calificado llega a tu CRM con su etiqueta, la conversación completa y un negocio creado en el embudo. Tus asesores entran cuando hay una oportunidad real, no antes.',
    ctaLabel: 'Conversar con Livvo →',
    ctaHref: WHATSAPP_URL,
    ctaVariant: 'primary',
  },
] as const;

// Dos tipos de funcionalidades (patrón useplaza): el servicio de atención
// al cliente que presta Luisa, y las herramientas de administración.
const featureTypes = {
  luisa: 'Luisa · Atención al cliente',
  admin: 'Livvo · CRM',
} as const;

const features = [
  {
    type: 'luisa',
    icon: 'chat',
    title: 'Atención al cliente 24/7 con IA',
    desc: 'Luisa responde en segundos, con el tono de tu inmobiliaria, a compradores, arrendatarios y propietarios en cualquier momento.',
  },
  {
    type: 'luisa',
    icon: 'filter',
    title: 'Calificación automática de leads',
    desc: 'Luisa detecta si el cliente quiere comprar, arrendar o vender, y captura presupuesto, zona y tipo de propiedad antes de pasarlo a tu equipo.',
  },
  {
    type: 'luisa',
    icon: 'home',
    title: 'Recomendación de inmuebles',
    desc: 'Cada lead recibe propiedades de tu portafolio que encajan con lo que busca, directo en el chat.',
  },
  {
    type: 'luisa',
    icon: 'target',
    title: 'IA supervisada por tu equipo',
    desc: 'Tú decides: Luisa responde sola o prepara borradores que tus asesores revisan y aprueban antes de enviar.',
  },
  {
    type: 'admin',
    icon: 'chat',
    title: 'Bandeja de entrada compartida',
    desc: 'Todo tu equipo atiende el WhatsApp de la inmobiliaria desde un solo lugar, con asignación de conversaciones, etiquetas y notas internas.',
  },
  {
    type: 'admin',
    icon: 'calendar-check',
    title: 'Embudo inmobiliario',
    desc: 'Negocios organizados en las etapas reales de tu operación, de lead nuevo a cierre ganado, con campos a tu medida: tipo de propiedad, operación, presupuesto y zona.',
  },
  {
    type: 'admin',
    icon: 'link',
    title: 'Flujos y automatizaciones',
    desc: 'Menús de opciones, respuestas automáticas y reglas que etiquetan leads y crean negocios en el embudo sin que nadie toque nada.',
  },
  {
    type: 'admin',
    icon: 'chart',
    title: 'Difusiones e informes',
    desc: 'Envía campañas de WhatsApp con plantillas aprobadas por Meta y mide conversaciones, negocios y conversión en tiempo real.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  filter: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  home: '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 8.5V21h14V8.5"/><path d="M9 21v-6h6v6"/>',
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  'calendar-check':
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 15h3M8 18h6"/>',  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15v3M12 10v8M17 6v12"/>',
};

const plans = [
  {
    name: '🚀 Plan Esencial',
    price: '$499.000',
    period: 'COP / mes',
    tagline: 'Para negocios que están empezando con IA',
    features: [
      'Hasta 500 conversaciones mensuales',
      'Operación 24/7 de tus Empleados IA',
      'Hasta 5 usuarios',
      'Ajustes y mejoras continuas',
      'Soporte básico',
    ],
    featured: false,
    ctaLabel: 'Comenzar ahora',
  },
  {
    name: 'Plan Profesional',
    price: '$749.000',
    period: 'COP / mes',
    tagline: 'Para negocios con alto volumen de mensajes',
    features: [
      'Hasta 1.000 conversaciones mensuales',
      'Operación 24/7 de tus Empleados IA',
      'Usuarios ilimitados',
      'Campañas de WhatsApp',
      'Módulo de plantillas de Meta',
      'Reunión mensual de optimización',
      'Ajustes y mejoras continuas',
      'Soporte prioritario',
      'Gerente de cuenta dedicado',
    ],
    featured: true,
    ctaLabel: 'Comenzar ahora',
  },
  {
    name: 'Plan Corporativo',
    price: 'A medida',
    period: '',
    tagline: 'Para operaciones que necesitan más',
    features: [
      'Volumen de conversaciones a medida',
      'Operación 24/7 de tus Empleados IA',
      'Usuarios ilimitados',
      'Campañas de WhatsApp',
      'Módulo de plantillas de Meta',
      'Reunión mensual de optimización',
      'Ajustes y mejoras continuas',
      'Soporte premium 24/7',
      'Gerente de cuenta dedicado',
      'Canales adicionales (Instagram, Messenger, etc.)',
