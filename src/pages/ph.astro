---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP_URL } from '../config';

const features = [
  {
    icon: 'chat',
    title: 'Atención al residente 24/7',
    desc: 'Responde dudas sobre el reglamento de convivencia, envía estados de cuenta individuales y agenda zonas comunes de forma autónoma, por WhatsApp.',
  },
  {
    icon: 'clipboard',
    title: 'Gestión automática de PQRS',
    desc: 'Radica cada solicitud, la clasifica por nivel de urgencia y asigna los reportes de daños al técnico correspondiente, con seguimiento hasta el cierre.',
  },
  {
    icon: 'trend',
    title: 'Cobranza preventiva y predictiva',
    desc: 'Analiza los patrones de pago para identificar qué residentes podrían entrar en mora y envía recordatorios automáticos adaptados a cada caso.',
  },
  {
    icon: 'scan',
    title: 'Lectura automatizada de facturas (OCR)',
    desc: 'Procesa cuentas de cobro y facturas de proveedores con solo tomarles una foto, cruzando los datos directamente con tu sistema contable.',
  },
  {
    icon: 'shield',
    title: 'Portería y seguridad asistida',
    desc: 'Agiliza el ingreso de visitantes con validación de datos, controla la mensajería y se conecta con tu citofonía inteligente.',
  },
];

const featureIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  clipboard:
    '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 12h6M9 16h4"/>',
  trend: '<path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/>',
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 12h10"/>',
  shield:
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
};
---

<Base
  title="Agentes IA para Propiedad Horizontal — Livvo"
  description="Agentes de IA que leen el reglamento de tu copropiedad y responden con base en él: atención al residente 24/7, PQRS, cobranza, facturas y portería, en el WhatsApp de tu administración."
>
  <Navbar />

  <main>
    <!-- HERO centrado, estilo declaración -->
    <header class="ph-hero">
      <div class="container-site">
        <span class="ph-hero__badge">Agentes IA · Propiedad Horizontal</span>
        <h1>
          Mejores experiencias para tus residentes.
          <em class="grad-text">Construidas con Livvo.</em>
        </h1>
        <p class="ph-hero__sub">
          Agentes de IA que leen el reglamento de tu copropiedad y responden con base en él:
          atención al residente 24/7, PQRS, cobranza, facturas y portería — en el mismo WhatsApp
          de tu administración.
        </p>
        <div class="ph-hero__ctas">
          <Button href={WHATSAPP_URL} target="_blank" size="lg" id="ph-demo-cta">
            Prueba 15 días gratis →
          </Button>
        </div>
      </div>
    </header>

    <!-- QUÉ HACEN LOS AGENTES -->
    <Section
      alt
      eyebrow="Tecnología RAG"
      title="Entrenados con el reglamento de tu copropiedad"
      subtitle="Los agentes operan con Generación Aumentada por Recuperación (RAG): leen el reglamento y los documentos específicos de tu PH y responden con base en ellos — no con respuestas genéricas."
    >
      <div class="phfeatures fade-up">
        {features.map(({ icon, title, desc }) => (
          <article class="phfeature">
            <span class="phfeature__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={featureIcons[icon]}
              />
            </span>
            <h3 class="phfeature__title">{title}</h3>
            <p class="phfeature__desc">{desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- CTA FINAL -->
    <Section eyebrow="Pruébalo" title="Mira un agente de PH en acción">
      <div class="ph-cta fade-up">
        <p>
          La mejor forma de evaluar un agente de IA es conversar con uno. Escríbenos por WhatsApp
          y mira cómo atiende a un residente, radica una PQRS y gestiona la cobranza en una
          conversación real.
        </p>
        <Button href={WHATSAPP_URL} target="_blank" size="lg" id="ph-cta-final">
          Prueba 15 días gratis →
        </Button>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .ph-hero {
    padding: 150px 0 80px;
    text-align: center;
  }
  .ph-hero__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 199, 180, 0.4);
    color: var(--teal-deep);
    background: rgba(0, 199, 180, 0.08);
  }
  .ph-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--navy);
    max-width: 820px;
    margin: 0 auto 20px;
  }
  .ph-hero h1 em {
    font-style: normal;
    display: block;
  }
  .ph-hero__sub {
    color: var(--muted);
    font-size: 18px;
    line-height: var(--lh-body);
    max-width: 680px;
    margin: 0 auto 32px;
  }
  .ph-hero__ctas {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- Tarjetas de funciones (mismo patrón de las páginas de producto) ---- */
  .phfeatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .phfeature {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    transition: box-shadow var(--transition), border-color var(--transition),
      background-color var(--transition), transform var(--transition);
  }
  .phfeature:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    background: rgba(0, 199, 180, 0.06);
    border-color: rgba(0, 199, 180, 0.45);
  }
  .phfeature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    margin-bottom: var(--space-4);
    background: rgba(0, 199, 180, 0.1);
    color: var(--teal-deep);
    transition: background-color var(--transition), color var(--transition);
  }
  .phfeature:hover .phfeature__icon {
    background: var(--grad-cta);
    color: #fff;
  }
  .phfeature__title {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-2);
  }
  .phfeature__desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    margin: 0;
  }

  .ph-cta {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .ph-cta p {
    color: var(--muted);
    font-size: 16px;
    line-height: var(--lh-body);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .phfeatures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ph-hero { padding: 130px 0 60px; }
    .phfeatures { grid-template-columns: 1fr; }
  }
</style>
